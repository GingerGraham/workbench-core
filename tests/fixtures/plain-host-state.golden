## exported env
HOME=@WORK@/plain/home
PATH=@WORK@/plain/home/.local/bin:/usr/local/bin:/usr/bin:/bin
SHLVL=1
TERM=dumb
WORKBENCH_LOADER_PATH=@WORK@/plain/data/workbench/modules/core/current/lib/loader.sh
WORKBENCH_PLATFORM_DETECTED=true
WORKBENCH_PROMPT_ENGINE=fallback
