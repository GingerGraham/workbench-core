#!/usr/bin/env bash
# bin/wb — the workbench-core CLI dispatcher.
#
# install/apply/add/remove/track/dev/sync/update/status/functions
# (docs/architecture.md §10). This script sources the whole shell library once
# and dispatches to it — it deliberately contains no fetch/deploy/resolve
# logic of its own (that all lives in lib/, shared with the loader and the
# timer).
set -uo pipefail

# `bin/wb` is now reached via `~/.local/bin/wb`, a symlink to this file
# inside `core/current/bin/` (bin/wb's own _wb_link_cli_bin, called from `wb
# install`/`wb apply` — docs/decisions-log.md D19). `dirname "${BASH_SOURCE[0]}"`
# alone resolves relative to the symlink's own location (~/.local/bin), not
# its target, which would point WB_ROOT/LIB at the wrong tree entirely
# (flagged in PR review). Follow the symlink chain manually first — plain
# `readlink` (no `-f`, a GNU-only extension BSD/macOS readlink lacks) is the
# same portable primitive already used for this in
# lib/distribution/snapshot.sh.
_wb_self="${BASH_SOURCE[0]}"
while [[ -L "${_wb_self}" ]]; do
    _wb_self_dir="$(cd "$(dirname "${_wb_self}")" && pwd)"
    _wb_self="$(readlink "${_wb_self}")"
    case "${_wb_self}" in
        /*) ;;
        *) _wb_self="${_wb_self_dir}/${_wb_self}" ;;
    esac
done
unset _wb_self_dir

WB_BIN_DIR="$(cd "$(dirname "${_wb_self}")" && pwd)"
unset _wb_self
WB_ROOT="$(cd "${WB_BIN_DIR}/.." && pwd)"
LIB="${WB_ROOT}/lib"
export WORKBENCH_CORE_INSTALL_DIR="${WB_ROOT}"

# _wb_require <lib-relative-path> [<lib-relative-path> ...]
# Idempotent lazy-source: sources each given lib/-relative path exactly
# once per process, no matter how many call sites ask for it — backed by
# the same _WB_SCRIPT_VERSIONS dedup core/version.sh already maintains,
# so this adds no new bookkeeping. Called from inside the specific
# function that actually needs the content (workbench_sync_module,
# workbench_cmd_add, etc.), not from the top-level dispatch case — a
# dispatch arm can't reliably anticipate everything it transitively
# calls into, but the function doing the actual work always knows
# exactly what it needs, and co-locating the requirement there keeps it
# correct as the codebase changes instead of needing to be kept in sync
# by hand from a distance.
#
# _workbench_script_version_registered is checked against "lib/<path>",
# not <path> itself: every file's own bottom-line
# _workbench_register_script_version call (the fixed always-load loop's
# files included) registers under its full repo-root-relative path
# ("lib/distribution/fetch-tarball.sh", never "distribution/fetch-
# tarball.sh") — that's what `wb version`'s listing and
# tests/check-wb-version.sh already expect, and it predates this
# function. Checking the bare <path> here would never match a real
# registration and defeat the dedup entirely, silently re-sourcing every
# lazy file on every call (caught by tests/check-wb-lazy-load.sh while
# building this).
_wb_require() {
    local _wb_req_f
    for _wb_req_f in "$@"; do
        if command -v _workbench_script_version_registered &>/dev/null \
            && _workbench_script_version_registered "lib/${_wb_req_f}"; then
            continue
        fi
        # shellcheck disable=SC1090
        source "${LIB}/${_wb_req_f}"
    done
}

# Always-loaded: foundational, needed by nearly every subcommand,
# including the two highest-frequency, read-only paths — the hidden
# __complete dispatcher (D54, called on every keystroke of second-level
# tab completion) and `wb functions`. Kept deliberately generous rather
# than pared to the bone — see docs/decisions-log.md D65.
for _wb_f in \
    core/log.sh core/version.sh core/functions.sh core/pager.sh core/completion.sh loader-select.sh core/semver.sh core/prereqs.sh \
    manifest/parse.sh \
    sync/state.sh sync/engine.sh \
    core/tools.sh \
    ; do
    # shellcheck disable=SC1090
    source "${LIB}/${_wb_f}"
done
unset _wb_f

# Everything below is loaded lazily via _wb_require, from inside the
# function that actually needs it, the first time that function actually
# runs — not here. See _wb_require's own comment for why the requiring
# call lives at the point of use rather than in this fixed list.
# core/version.sh loads second (right after core/log.sh, which every
# _workbench_register_script_version call site below needs for nothing but
# every registration call itself needs core/version.sh already sourced) so
# every other file's own registration line — guarded with
# `command -v _workbench_register_script_version &>/dev/null &&` for when
# it's sourced standalone elsewhere — actually fires during this pass.
# shellcheck disable=SC2015
command -v _workbench_register_script_version &>/dev/null && _workbench_register_script_version "bin/wb" "1.11.1" || true

_wb_usage() {
    cat <<'EOF'
Usage: wb <command> [args]

Run 'wb help <command>' or 'wb <command> --help' for full details on any
command below.

DAILY USE
  status                      What's installed, tracked, and in sync.
  update [<name>]             Fetch + deploy the latest content now, for one
                               module or all of them (code-level only — see
                               'wb apply' for host-level setup). Updating
                               'core' also auto-triggers 'wb apply' when
                               core's commit actually changed.
  functions                   List registered shell functions/getters.
  tools [list [--status] | install <name>|all | upgrade [<name>|all]]
                               List/run the install-* functions modules
                               declared via register.installers[] — manual
                               only, never on the sync timer. 'install'
                               always needs an explicit target ('all' asks
                               first); 'upgrade' only touches tools already
                               reporting installed. Confused with 'wb
                               update'? 'wb update' keeps your MODULES
                               current; 'wb tools' keeps the software those
                               modules told you how to install current.

SETUP & HOST-LEVEL CONVERGENCE
  install [--bundle <name> [--use-files [--follow]]] [--skip-ansible]
                               First-run setup: prereqs, core bootstrap, PATH
                               symlink, shell rc stub, SSH deploy keys,
                               Ansible.
  apply [--skip-ansible]      Re-run the same setup as 'install', non-
                               interactively. 'wb update core' already
                               triggers this automatically when core
                               changes — run by hand for anything else.
  scheduler enable|disable|status
                               Turn the OS-level scheduled-sync timer on/off
                               for this whole host. OFF by default — see
                               'wb sync enable|disable [<name>]' for the
                               per-module layer underneath it.

MANAGING MODULES
  add <name> [url] [--private] [--allow-hooks] [--keep-files|--use-files] [--skip-layer <id>]
                               Register + immediately sync a new module.
  remove <name> [--restore]    Deregister (content on disk is left alone,
                               unless --restore puts back what it replaced).
  track <name> --latest | --branch <b> | --tag <t> | --commit <sha>
                               Pin what a module tracks, then sync it once.
  dev [<name>]                 Guided, interactive prompt wrapping 'track'.
  sync enable|disable [<name>]
                               Turn a module's background auto-sync on/off —
                               independent of WHAT it tracks (that's
                               'track'/'dev'). No name = core.
  module info <name> | docs <name>
                               What a module publishes about itself — info
                               (repo, tracking, an optional description) or
                               docs (its HELP.md/README.md in full). Not the
                               same as 'wb help <command>' — that's this
                               CLI's own usage text.

YOUR CONFIG FILES
  files status|diff|use|resolve|policy|restore|settle
                               See and decide what happens to every file a
                               module deploys: which are yours, which follow
                               the module, what's waiting on you. Workbench
                               never removes or replaces a file it didn't
                               put there — 'wb help files' for the details.

ADVANCED / INTERNAL
  sync run-if-due              Used by the background timer; a no-op unless
                               the current cadence interval has elapsed. Not
                               normally run by hand.
  version                      Release version and every loaded file's own
                               script-local version.
  completion bash|zsh          Print a tab-completion script for the
                               given shell. Wired up automatically — you
                               don't need to run this by hand.
EOF
}

# ── install / apply ───────────────────────────────────────────────────────
_wb_bootstrap_core_module() {
    # Core's own initial registration — but only reached by ONE of the two
    # ways `wb install` ever runs. The production path is `bootstrap.sh`
    # (repo root): it fetches a real, immutable snapshot into
    # snapshots/<ref-slug>-<shortsha>/, writes core's sync.conf itself
    # (TRACK_MODE=latest, a real RESOLVED_SHA), and only then hands off to
    # `bin/wb install` — by the time this function runs in that case, core
    # is already registered and the early-return below fires; this
    # function's body never executes for a bootstrap.sh-driven install at
    # all. The `.git`-presence branch further down is reached in exactly
    # one case: a developer's own `git clone` + `./bin/wb install`
    # (docs/architecture.md §9.6's "developer's own working clone"), where there
    # genuinely is nothing to fetch because this running checkout already
    # IS the content — see fix-brief §3.3.
    if workbench_is_registered core && [[ -d "$(workbench_module_current_dir core)" ]]; then
        log_info "wb install: core is already bootstrapped"
        return 0
    fi

    local module_dir snapshot_dir
    module_dir="$(workbench_module_dir core)"
    mkdir -p "${module_dir}/snapshots"
    snapshot_dir="${module_dir}/snapshots/local-checkout"
    [[ -L "${snapshot_dir}" || -e "${snapshot_dir}" ]] || ln -s "${WB_ROOT}" "${snapshot_dir}"
    _wb_require distribution/snapshot.sh
    workbench_snapshot_swap core "${snapshot_dir}"

    local track_mode="latest"
    if [[ -d "${WB_ROOT}/.git" ]]; then
        local branch
        branch="$(git -C "${WB_ROOT}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
        track_mode="branch:${branch}"
    fi

    workbench_module_conf_set core REPO_URL "https://github.com/GingerGraham/workbench-core.git"
    workbench_module_conf_set core PRIVATE "false"
    workbench_module_conf_set core TRACK_MODE "${track_mode}"
    workbench_module_conf_set core REGISTERED "true"
    workbench_module_conf_set core SYNC_ENABLED "true"
    workbench_module_conf_set core ALLOW_HOOKS "false"
    workbench_module_conf_set core RESOLVED_SHA "local-checkout"

    workbench_render_register_list core
    log_info "wb install: core bootstrapped from ${WB_ROOT} (tracking ${track_mode})"
}

_wb_converge_module_registrations() {
    # Unconditional, idempotent convergence step (fix-brief §1): every
    # loadable module's register.list (and installers.list — §3) is
    # (re-)rendered on every `wb install`/`wb apply` run, regardless of
    # whether anything actually changed. Before this existed,
    # register.list was only ever written as an incidental side effect of
    # _wb_bootstrap_core_module's non-early-return body (never reached on a
    # bootstrap.sh-driven install, since core is already registered by the
    # time this process starts) or a sync cycle that detected a real
    # upstream commit change — leaving core's own register.list silently
    # absent, and its shell content (get-functions, sudo-test, etc.) never
    # reaching a real interactive shell, for anyone following the
    # documented bootstrap.sh install path. One general fix for every
    # module, not a core-specific patch (principle 4).
    local name
    while IFS= read -r name; do
        [[ -z "${name}" ]] && continue
        workbench_render_register_list "${name}"
        workbench_render_installers_list "${name}"
        workbench_render_getters_list "${name}"
    done < <(workbench_list_loadable_modules)
}

_wb_link_cli_bin() {
    local bin_dir="${HOME}/.local/bin"
    local target link
    target="$(workbench_module_current_dir core)/bin/wb"
    link="${bin_dir}/wb"

    mkdir -p "${bin_dir}"

    if [[ -e "${link}" && ! -L "${link}" ]]; then
        log_warn "wb install: ${link} exists and is not a symlink — leaving it alone. Remove it manually and re-run 'wb apply' to let workbench manage it."
        return 0
    fi

    if [[ -L "${link}" ]]; then
        local current_target
        current_target="$(readlink "${link}")"
        case "${current_target}" in
            "$(workbench_modules_dir)/core/"*) ;; # ours — safe to update
            *)
                log_warn "wb install: ${link} is a symlink to something workbench didn't create (${current_target}) — leaving it alone."
                return 0
                ;;
        esac
    fi

    if ln -sfn "${target}" "${link}"; then
        log_info "wb install: linked ${link} -> ${target}"
    else
        log_error "wb install: failed to link ${link} -> ${target}"
        return 1
    fi
}

_wb_write_rc_stub() {
    local rc_file="$1" marker="# workbench-core loader"
    local loader_path="\${XDG_DATA_HOME:-\${HOME}/.local/share}/workbench/modules/core/current/lib/loader.sh"
    local stub_line="[ -f \"${loader_path}\" ] && source \"${loader_path}\"  ${marker}"

    if [[ -s "${rc_file}" ]] && ! grep -qF "${marker}" "${rc_file}" 2>/dev/null; then
        # First time workbench has ever touched this file, and it already
        # has real content — back it up before appending anything, so a
        # previous dotfiles setup, a distro default, or a custom prompt
        # is never silently at risk. Reuses the same engine-computed
        # backup root every force-overwrite deploy already uses
        # (docs/decisions-log.md D53) — the "rc-stub" tag keeps these
        # filterable without a second backup-directory convention.
        if ! workbench_backup_existing_file "${rc_file}" "rc-stub"; then
            log_error "wb install: could not back up ${rc_file} — leaving it untouched, not adding the loader stub"
            return 1
        fi
        log_warn "wb install: ${rc_file} had existing content — backed up under \${XDG_DATA_HOME:-\${HOME}/.local/share}/workbench/backups/ before adding the loader stub."
        log_warn "wb install: review the backup and copy anything you want to keep into a new file under \${XDG_CONFIG_HOME:-\${HOME}/.config}/workbench/local/ (e.g. 90-migrated.sh)."
    fi

    touch "${rc_file}"
    if grep -qF "${marker}" "${rc_file}" 2>/dev/null; then
        return 0
    fi
    printf '\n%s\n' "${stub_line}" >> "${rc_file}"
    log_info "wb install: added loader stub to ${rc_file}"
}

_wb_scaffold_local_overrides() {
    # Nothing renders ${XDG_CONFIG_HOME:-~/.config}/workbench/local/ on its
    # own — fix-brief §2. Creates the directory if absent and writes a
    # default settings.sh if absent, never overwriting an existing one
    # (same non-clobbering discipline _workbench_ensure_version_file already
    # follows for the version file), so a new user has commented examples
    # of the documented switches to look at rather than an empty file and a
    # doc page.
    local dir="${XDG_CONFIG_HOME:-${HOME}/.config}/workbench/local"
    local settings="${dir}/settings.sh"

    mkdir -p "${dir}"
    [[ -f "${settings}" ]] && return 0

    cat > "${settings}" <<'EOF'
#!/usr/bin/env bash
# ~/.config/workbench/local/settings.sh — machine-local overrides.
#
# Sourced twice by lib/loader.sh: once early (before the loader tiers, so
# flags set here gate their behaviour) and again at the very end (so it
# wins over anything a tier also touched). Uncomment any of the switches
# below to change this shell's behaviour.
#
# Any OTHER *.sh file dropped into this same directory (workbench/local/)
# is sourced once, together, filename-sorted, right after this file's
# final pass — put your own functions/aliases there instead of piling them
# up in this file. See docs/getting-started.md.

# Plain, unopinionated shell: disables the colourised prompt fallback and
# forces WORKBENCH_SHOW_FUNCTIONS off, regardless of its own setting below.
# WORKBENCH_PLAIN_SHELL=true

# Print loaded functions and getters at the start of each new interactive
# shell — a quick, unpaged summary (no aliases, never opens a pager, and
# functions that need tooling you don't have collapse to one line; run
# `wb functions` by hand for the full listing, aliases and details included).
# WORKBENCH_SHOW_FUNCTIONS=true

# Verbose loader/sync debug logging (release version, script versions,
# cadence decisions, etc.) — noisy, off by default.
# WORKBENCH_DEBUG=true

# Disable ~/.config/workbench/user/*.sh entirely (hand-authored "pseudo-
# module" extensions) — on by default.
# WORKBENCH_USER_EXT_ENABLED=false
EOF
    log_info "wb install: wrote default local-overrides file to ${settings}"
}

_wb_cmd_install() {
    local bundle="" skip_ansible="false" use_files="false" keep_files="false" follow="false" yes="false"
    local -a failed_members=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --use-files) use_files="true" ;;
            --keep-files) keep_files="true" ;;
            --follow)    follow="true" ;;
            --yes|-y)    yes="true" ;;
            --bundle)
                if [[ -z "${2:-}" ]]; then
                    log_error "wb install: --bundle requires a value"
                    return 2
                fi
                bundle="$2"; shift
                ;;
            --skip-ansible) skip_ansible="true" ;;
            *) log_error "wb install: unknown argument '$1'"; return 2 ;;
        esac
        shift
    done
    if [[ "${use_files}" == "true" && -z "${bundle}" ]]; then
        log_error "wb install: --use-files goes with --bundle <name> (for a single module: wb add <name> --use-files)"
        return 2
    fi
    if [[ "${keep_files}" == "true" && "${use_files}" == "true" ]]; then
        log_error "wb install: --keep-files and --use-files contradict each other — pick one"
        return 2
    fi
    if [[ "${follow}" == "true" && "${use_files}" != "true" ]]; then
        log_error "wb install: --follow goes with --use-files"
        return 2
    fi
    # Refuse before registering anything: the --use-files confirmation
    # can't be asked without a terminal (D81).
    if [[ "${use_files}" == "true" && "${yes}" != "true" ]] && ! _wb_have_tty; then
        log_error "wb install: --use-files needs a terminal to confirm — re-run with --yes. Nothing was changed."
        return 1
    fi

    # An unknown bundle is a usage error, caught before anything is checked,
    # installed or written (D88).
    if [[ -n "${bundle}" ]]; then
        _wb_require modules/catalog.sh
        if ! workbench_catalog_bundle_modules "${bundle}" >/dev/null; then
            log_error "wb install: no bundle named '${bundle}'. Known bundles: $(workbench_catalog_list_bundles | tr '\n' ' ')— nothing was changed."
            return 2
        fi
    fi

    log_info "wb install: workbench-core release: $(_workbench_release_version)"
    log_info "wb install: checking prerequisites..."
    workbench_check_shell_prereqs >/dev/null
    if [[ "$(workbench_missing_shell_prereqs | wc -l | tr -d ' ')" -gt 0 ]]; then
        workbench_install_shell_prereqs || log_warn "wb install: could not install all missing prerequisites automatically — install them manually and re-run"
    fi

    _workbench_ensure_version_file
    _workbench_migrate_state_schema
    _workbench_sync_version_facts

    mkdir -p "${XDG_CONFIG_HOME:-${HOME}/.config}/workbench" \
             "${XDG_DATA_HOME:-${HOME}/.local/share}/workbench" \
             "${XDG_CACHE_HOME:-${HOME}/.cache}/workbench"

    _wb_scaffold_local_overrides
    _wb_bootstrap_core_module
    _wb_converge_module_registrations
    _wb_link_cli_bin

    _wb_write_rc_stub "${HOME}/.bashrc"
    if [[ -n "${ZSH_VERSION:-}" || -f "${HOME}/.zshrc" ]]; then
        _wb_write_rc_stub "${HOME}/.zshrc"
        _wb_write_rc_stub "${HOME}/.zshenv"
    fi

    if [[ -n "${bundle}" ]]; then
        _wb_require modules/catalog.sh modules/add.sh
        local member install_mode="ask" install_rc=0
        local -a members=() staged=()
        while IFS= read -r member; do
            [[ -z "${member}" ]] && continue
            members+=("${member}")
            if workbench_is_registered "${member}"; then
                log_info "wb install: '${member}' is already registered"
                continue
            fi
            if workbench_cmd_add "${member}" --stage-only </dev/null; then
                staged+=("${member}")
            else
                failed_members+=("${member}")
            fi
        done < <(workbench_catalog_bundle_modules "${bundle}")
        # One plan and one question across the whole bundle, after the
        # loop (D84). Modules registered before keep D81's --use-files.
        [[ "${keep_files}" == "true" ]] && install_mode="keep"
        [[ "${use_files}" == "true" ]] && install_mode="use"
        if [[ "${#staged[@]}" -gt 0 ]]; then
            _wb_install_modules "${install_mode}" "${follow}" "${yes}" add "${staged[@]}" || install_rc=$?
            [[ "${install_rc}" -ne 0 && "${install_rc}" -ne 3 ]] && \
                log_warn "wb install: not every file was deployed — see above; 'wb files status' shows where things stand"
        fi
        local -a earlier=()
        for member in ${members[@]+"${members[@]}"}; do
            case " ${staged[*]:-} " in *" ${member} "*) continue ;; esac
            earlier+=("${member}")
        done
        if [[ "${use_files}" == "true" && "${#earlier[@]}" -gt 0 ]]; then
            _wb_files_use_at_install "${follow}" "${yes}" "${earlier[@]}" \
                || log_warn "wb install: --use-files didn't complete for every file — see above; 'wb files status' shows where things stand"
        fi
    fi

    _wb_require ssh/bootstrap.sh
    workbench_ssh_bootstrap_all
    _wb_require sync/scheduler.sh
    workbench_scheduler_install

    if [[ "${skip_ansible}" == "true" ]]; then
        log_warn "wb install: --skip-ansible given — skipping the Ansible convergence step (host_vars templating etc.), regardless of whether ansible-playbook is available. The shell itself is already fully bootstrapped."
    elif command -v ansible-playbook &>/dev/null; then
        log_info "wb install: running Ansible convergence..."
        (
            cd "${WB_ROOT}/ansible" && \
            ANSIBLE_CONFIG="${WB_ROOT}/ansible/ansible.cfg" \
            ansible-playbook -i inventory/localhost.yml \
                -e "workbench_core_install_dir=${WB_ROOT}" \
                playbooks/core.yml
        ) || log_warn "wb install: Ansible convergence reported a failure — the pure-shell bootstrap above already produced a working shell; see output for what Ansible additionally couldn't do"
    else
        log_warn "wb install: ansible-playbook not found — skipping the Ansible convergence step (host_vars templating etc.). The shell itself is already fully bootstrapped."
    fi

    log_info "wb install: done. Start a new shell (or 'source ~/.bashrc') to load workbench-core."

    if [[ "${#failed_members[@]}" -gt 0 ]]; then
        log_error "wb install: these bundle modules were not registered: ${failed_members[*]} — run 'wb add <name>' for each to see why"
        return 1
    fi
}

_wb_cmd_apply() {
    _wb_cmd_install "$@"
}

# ── core self-convergence on update (docs/decisions-log.md D20) ──────────────
# _wb_maybe_reconverge_core <before-sha> <unattended:true|false>
#
# `core` is module zero — it IS workbench-core itself, so a code change to
# it (the D19 PATH-symlink fix is the motivating example) can change
# host-level state that only `wb apply` knows how to (re-)converge. Every
# other module has no install/apply concept, so this is deliberately scoped
# to `core` only and lives here at the CLI layer, never inside
# lib/sync/engine.sh (principle 4 — no core-specific branch in the generalised
# engine).
#
# Fires only when core's resolved commit actually changed (never on a bare
# "a sync cycle ran"), and never propagates a convergence failure as the
# calling command's own exit status — a hiccup here is logged as a warning,
# not a failure of the sync that triggered it.
_wb_maybe_reconverge_core() {
    local before_sha="$1" unattended="$2"

    workbench_is_registered core || return 0

    local after_sha
    after_sha="$(workbench_module_conf_get core RESOLVED_SHA "")"
    [[ "${after_sha}" == "${before_sha}" ]] && return 0

    log_info "wb: core's resolved commit changed (${before_sha:-none} -> ${after_sha:0:7}) — re-running convergence (wb apply) so the host stays fully converged"

    # Two explicit calls rather than building a possibly-empty args array and
    # expanding "${apply_args[@]}" — bash before 4.4 (still bash 3.2, macOS's
    # default /bin/bash, per docs/architecture.md's compatibility target) raises
    # "unbound variable" expanding an empty array under `set -u`, which this
    # file runs under.
    #
    # The new release's own wb runs it, as a child process (D85): this
    # process's functions — the core API version it states, the deploy
    # code — are still the release that was running before the update.
    local apply_rc=0 next
    next="$(_wb_core_next_wb)"
    if [[ -n "${next}" && "${unattended}" == "true" ]]; then
        "${next}" apply --skip-ansible || apply_rc=$?
    elif [[ -n "${next}" ]]; then
        "${next}" apply || apply_rc=$?
    elif [[ "${unattended}" == "true" ]]; then
        _wb_cmd_apply --skip-ansible || apply_rc=$?
    else
        _wb_cmd_apply || apply_rc=$?
    fi
    if [[ "${apply_rc}" -ne 0 ]]; then
        log_warn "wb: core convergence pass failed after update — the host may not be fully converged (PATH symlink/rc stub/prereqs); run 'wb apply' by hand to retry"
    fi
    return 0
}

# ── handing the rest of a sync to new core code (docs/decisions-log.md D85) ──
# _wb_core_next_wb
# Prints the wb in core's current snapshot when it isn't the one running
# and knows '__sync-continue'; prints nothing otherwise (no core module, a
# developer checkout, or a pin back to a release from before D85).
_wb_core_next_wb() {
    local next
    workbench_is_registered core || return 0
    next="$(workbench_module_current_dir core)/bin/wb"
    [[ -x "${next}" ]] || return 0
    [[ "$(cd "$(dirname "${next}")/.." && pwd -P)" == "$(cd "${WB_ROOT}" && pwd -P)" ]] && return 0
    grep -q '__sync-continue)' "${next}" 2>/dev/null || return 0
    printf '%s\n' "${next}"
}

# _wb_sync_modules <reason> <core-sha-before> <module>...
# Syncs each module in the order given, isolated as workbench_sync_all
# does, then marks the cadence. core is module zero, first in registered
# order: when its sync brings in different code, this process stops and
# the new release's wb syncs the rest ('wb __sync-continue'). Without that,
# a module needing the new release's Core API would be synced by the old
# one — its shell content refused, its layers unknown to the deploy code —
# and never revisited, since its RESOLVED_SHA has moved.
_wb_sync_modules() {
    local reason="$1" before="$2" m next
    shift 2
    # D36: CORE_API_VERSION states what the running code provides; set it
    # before anything is rendered against it, not only at the next apply.
    _workbench_sync_version_facts
    while [[ $# -gt 0 ]]; do
        m="$1"
        shift
        workbench_sync_run_one "${m}" "${reason}" || true
        [[ "${m}" == "core" ]] || continue
        [[ "$(workbench_module_conf_get core RESOLVED_SHA "")" == "${before}" ]] && continue
        next="$(_wb_core_next_wb)"
        [[ -z "${next}" ]] && continue
        log_info "wb: core updated — continuing with its new release"
        # SC2093: replacing this process is the point — nothing after runs.
        # shellcheck disable=SC2093
        exec "${next}" __sync-continue "${reason}" "${before}" "$@"
    done
    workbench_cadence_mark_ran
}

# _wb_cmd_sync_continue <reason> <core-sha-before> <module>... — internal.
# Run only by an older release's _wb_sync_modules, as above: finishes that
# command — the remaining modules, then what 'wb update' (reason manual)
# or 'wb sync run-if-due' (scheduled) does after its sync. Kept stable
# across releases: every later release must accept these arguments.
_wb_cmd_sync_continue() {
    local reason="${1:-manual}" before="${2:-}"
    shift 2 || true
    _wb_sync_modules "${reason}" "${before}" "$@"
    if [[ "${reason}" == "scheduled" ]]; then
        _wb_maybe_reconverge_core "${before}" true
    else
        _wb_files_prompt_pending
        _wb_maybe_reconverge_core "${before}" false
    fi
}

# ── sync ───────────────────────────────────────────────────────────────────
_wb_cmd_sync() {
    _wb_require sync/scheduler.sh
    local sub="${1:-}"; shift || true
    case "${sub}" in
        enable|disable)
            _wb_require modules/sync-toggle.sh
            workbench_cmd_sync_toggle "${sub}" "$@"
            ;;
        run-if-due)
            # The one-time upgrade-safety migration normally runs inside
            # workbench_scheduler_install (wb install/wb apply). But a host
            # can auto-update core entirely through its own already-active
            # OS timer firing run-if-due — nobody ever runs `wb apply` by
            # hand — and core's own auto-reconvergence (which would
            # otherwise reach workbench_scheduler_install) lives BELOW this
            # gate. Without running the migration here too, a pre-existing
            # Ansible-era timer would get silently and permanently gated
            # off the first time scheduler.conf doesn't exist yet: this
            # firing no-ops before ever syncing core, so the apply that
            # would perform the migration never happens either. Cheap
            # no-op on every later call once scheduler.conf exists.
            _workbench_scheduler_migrate_existing_install
            if ! workbench_scheduler_enabled; then
                log_debug "wb sync run-if-due: scheduled sync is disabled — no-op"
                return 0
            fi
            log_debug "wb sync run-if-due: workbench-core release $(_workbench_release_version), bin/wb v0.1.0"
            if workbench_sync_due; then
                local core_sha_before
                core_sha_before="$(workbench_module_conf_get core RESOLVED_SHA "")"
                local -a loadable=()
                local lm
                while IFS= read -r lm; do
                    [[ -n "${lm}" ]] && loadable+=("${lm}")
                done < <(workbench_list_loadable_modules)
                if [[ "${#loadable[@]}" -gt 0 ]]; then
                    _wb_sync_modules "scheduled" "${core_sha_before}" "${loadable[@]}"
                else
                    workbench_cadence_mark_ran
                fi
                _wb_maybe_reconverge_core "${core_sha_before}" true
            else
                log_debug "wb sync run-if-due: not due yet"
            fi
            ;;
        *)
            log_error "wb sync: usage: wb sync enable|disable [<name>] | wb sync run-if-due"
            return 2
            ;;
    esac
}

# ── scheduler ──────────────────────────────────────────────────────────────
_wb_cmd_scheduler() {
    _wb_require sync/scheduler.sh
    local sub="${1:-}"; shift || true
    case "${sub}" in
        enable)  workbench_scheduler_cmd_enable ;;
        disable) workbench_scheduler_cmd_disable ;;
        status)  workbench_scheduler_cmd_status ;;
        *)
            log_error "wb scheduler: usage: wb scheduler enable|disable|status"
            return 2
            ;;
    esac
}

# ── update ─────────────────────────────────────────────────────────────────
_wb_cmd_update() {
    local name="${1:-}"
    log_debug "wb update: workbench-core release $(_workbench_release_version), bin/wb v0.1.0"
    local core_sha_before
    core_sha_before="$(workbench_module_conf_get core RESOLVED_SHA "")"
    # D84: a module fetched but never deployed (the user quit at the
    # install question) is asked about again here, from a terminal. With
    # no terminal it deploys with the default answer, keep.
    local m rc=0
    local -a staged=() quit=()
    while IFS= read -r m; do
        [[ -z "${m}" ]] && continue
        [[ -n "${name}" && "${m}" != "${name}" ]] && continue
        staged+=("${m}")
    done < <(_wb_install_staged_modules)
    if [[ "${#staged[@]}" -gt 0 ]]; then
        _wb_install_modules ask false false manual "${staged[@]}" || rc=$?
        [[ "${rc}" -eq 3 ]] && quit=("${staged[@]}")
    fi
    if [[ -n "${name}" ]]; then
        [[ "${#quit[@]}" -gt 0 ]] || { _workbench_sync_version_facts; workbench_sync_module "${name}" "manual"; }
    else
        # Every loadable module, minus what the user just said not to touch.
        local -a todo=()
        while IFS= read -r m; do
            [[ -z "${m}" ]] && continue
            case " ${quit[*]:-} " in *" ${m} "*) continue ;; esac
            todo+=("${m}")
        done < <(workbench_list_loadable_modules)
        if [[ "${#todo[@]}" -gt 0 ]]; then
            _wb_sync_modules "manual" "${core_sha_before}" "${todo[@]}"
        else
            workbench_cadence_mark_ran
        fi
    fi
    # D81: from a terminal, ask about anything now waiting on the user —
    # a held link, an edited copy whose default moved. Never on non-TTY,
    # and never from the scheduled path (which doesn't come through here).
    _wb_files_prompt_pending
    _wb_maybe_reconverge_core "${core_sha_before}" false
}

# ── version ────────────────────────────────────────────────────────────────
_wb_cmd_version() {
    log_info "workbench-core release: $(_workbench_release_version)"
    log_info "loaded script versions:"
    _workbench_print_script_versions
}

# ── status ─────────────────────────────────────────────────────────────────
# _wb_status_check_rendered_lists
# Loud, explicit check (fix-brief §1; reworked per the installers-only-module
# false-positive brief, docs/decisions-log.md D71): a registered, sync-enabled
# module whose manifest declares register.shell[] entries but whose
# register.list is missing or empty means that module's shell content is
# silently never reaching a real shell. Declaring register.installers[]
# entries with installers.list missing or empty is the same class of gap for
# the tool-registry framework instead. These two manifest blocks render to
# two different files (register.list / installers.list —
# workbench_render_register_list / workbench_render_installers_list,
# lib/sync/engine.sh) and must be checked against their own file each: an
# installers-only module (register.installers[] only, no register.shell[])
# correctly has an empty register.list, since its content never renders
# there — checking register.list alone against the summed count produced a
# permanent false positive for exactly this shape (first seen:
# workbench-ai) that 'wb apply' could never clear.
_wb_status_check_rendered_lists() {
    local name current_dir manifest core_api reglist instlist shell_count installer_count

    while IFS= read -r name; do
        [[ -z "${name}" ]] && continue
        current_dir="$(workbench_module_current_dir "${name}")"
        manifest="$(workbench_resolve_manifest_path "${current_dir}")"
        [[ -f "${manifest}" ]] || continue

        core_api="$(workbench_manifest_scalar core_api "${manifest}")"
        [[ -z "${core_api}" ]] && continue

        shell_count="$(workbench_manifest_register_shell_entries "${manifest}" | wc -l | tr -d ' ')"
        installer_count="$(workbench_manifest_register_installer_entries "${manifest}" | wc -l | tr -d ' ')"

        if [[ "${shell_count}" -gt 0 ]]; then
            reglist="$(workbench_module_dir "${name}")/register.list"
            if [[ ! -s "${reglist}" ]]; then
                log_warn "wb status: '${name}' declares register.shell[] entries but register.list is missing or empty — its shell content is NOT reaching new shells. Run 'wb apply' to re-render it."
            fi
        fi

        if [[ "${installer_count}" -gt 0 ]]; then
            instlist="$(workbench_module_dir "${name}")/installers.list"
            if [[ ! -s "${instlist}" ]]; then
                log_warn "wb status: '${name}' declares register.installers[] entries but installers.list is missing or empty — its installers are NOT visible to 'wb tools'. Run 'wb apply' to re-render it; if it stays empty, check the declared file defines install-<name> functions."
            fi
        fi
    done < <(workbench_list_loadable_modules)
}

_wb_cmd_status() {
    local name mode ref sha enabled registered hooks_pending fast="no"
    [[ "$(workbench_cadence_seconds)" -eq "${WORKBENCH_CADENCE_FAST_SECONDS}" ]] && fast="yes"

    printf '%-20s %-10s %-20s %-10s %-10s %-10s %-14s\n' "MODULE" "MODE" "REF" "SHA" "SYNC" "REGISTERED" "HOOKS_PENDING"
    while IFS= read -r name; do
        [[ -z "${name}" ]] && continue
        mode="$(workbench_module_conf_get "${name}" TRACK_MODE latest)"
        ref="$(workbench_module_conf_get "${name}" TRACK_REF "")"
        sha="$(workbench_module_conf_get "${name}" RESOLVED_SHA "")"
        enabled="$(workbench_module_conf_get "${name}" SYNC_ENABLED true)"
        registered="$(workbench_module_conf_get "${name}" REGISTERED true)"
        hooks_pending="$(workbench_module_conf_get "${name}" HOOKS_PENDING false)"
        printf '%-20s %-10s %-20s %-10s %-10s %-10s %-14s\n' "${name}" "${mode}" "${ref:--}" "${sha:0:10}" "${enabled}" "${registered}" "${hooks_pending}"
    done < <(workbench_list_all_modules)

    echo
    echo "Fast (5-minute) cadence active: ${fast}"

    _wb_status_check_rendered_lists

    local files_waiting
    files_waiting="$(_wb_files_pending_total)"
    if [[ "${files_waiting}" -gt 0 ]]; then
        echo "Files waiting on you: ${files_waiting} — run 'wb files status'"
    fi
}

# ── functions ──────────────────────────────────────────────────────────────
# _wb_cmd_functions [--all] [--no-pager] [--no-aliases] [--compact]
# Thin wrapper around _wb_cmd_functions_impl (the actual listing logic,
# unchanged below): scans all of $@ for --all/--no-pager — order-
# independent, unlike a bare "${1:-}" == "--all" check — then pipes the
# impl's output through _wb_maybe_page unless --no-pager was given.
# --no-aliases and --compact aren't parsed here at all: they're forwarded
# to _wb_cmd_functions_impl unchanged via "$@" and handled entirely there
# (docs/decisions-log.md D73, D86), since they only affect what the impl
# prints, not whether/how this wrapper pages it.
# _wb_availability_timeout_reset moved here (was previously the first
# thing inside the old single function) so it always runs once, in this
# process, before _wb_cmd_functions_impl forks into the pipeline below —
# it only touches a state file, so where it runs relative to the pipe
# doesn't matter, but running it twice (once per branch) would be
# pointless duplication.
_wb_cmd_functions() {
    local _wb_fn_arg _wb_fn_no_pager="false"
    for _wb_fn_arg in "$@"; do
        case "${_wb_fn_arg}" in
            --all)
                # shellcheck disable=SC2034  # read by _wb_function_available
                # (lib/core/functions.sh), a different file shellcheck can't see
                # into from here — not actually unused.
                WORKBENCH_FUNCTIONS_SHOW_ALL="true"
                ;;
            --no-pager) _wb_fn_no_pager="true" ;;
        esac
    done
    _wb_availability_timeout_reset

    if [[ "${_wb_fn_no_pager}" == "true" ]]; then
        _wb_cmd_functions_impl "$@"
    else
        # column (util-linux and BSD/macOS alike, docs/decisions-log.md
        # D73) falls back to $COLUMNS, then a fixed default, once its own
        # stdout isn't a tty — which is exactly what _wb_cmd_functions_impl's
        # stdout becomes the moment it's the left side of this pipe, even
        # though fd 1 genuinely is a real terminal one level up. Snapshot
        # the real width here, before that pipe exists, and export it so
        # column picks up the true width instead of silently collapsing to
        # a narrow default — but only when the caller hasn't already set
        # COLUMNS themselves, which always wins.
        if [[ -t 1 ]] && [[ -z "${COLUMNS:-}" ]]; then
            local _wb_fn_cols
            _wb_fn_cols="$(tput cols 2>/dev/null)"
            [[ -n "${_wb_fn_cols}" ]] && export COLUMNS="${_wb_fn_cols}"
        fi
        _wb_cmd_functions_impl "$@" | _wb_maybe_page
    fi
}

# Generalised get-functions (docs/architecture.md §3/§4): walks every
# registered module's declared files and extracts what's actually
# defined in them. One exclusion keeps this an accurate "what's
# actually loaded" list:
#   - platform/distro-tier files whose basename doesn't match this
#     host: lib/loader.sh only sources the matching one (e.g. a
#     registered macos.sh is never sourced on Linux). Applying
#     _wb_loader_should_source_by_name (lib/loader-select.sh — the
#     exact function the real loader uses, not a second copy) keeps
#     this listing honest on hosts with mixed-platform modules
#     registered.
#
# tier: lazy is NOT excluded here (docs/decisions-log.md D61,
# workbench-gpg#7) — see that entry for why.
#
# As of docs/decisions-log.md D65: register.list entries and
# manifest-declared getters are gathered in one walk of
# workbench_list_loadable_modules instead of two, and the "Loaded
# functions"/"Loaded aliases" name lists come from the live shell
# function/alias table after sourcing eager_files once, rather than a
# second grep pass re-opening every one of those files — this
# environment's per-file-open cost is real (confirmed against a live
# trace) and worth avoiding on a command this frequently invoked.
#
# --no-aliases (docs/decisions-log.md D73) skips both computing and
# printing the "Loaded aliases" section — not just hiding it after the
# fact, since the alias snapshot/diff (alias -p twice, sort, comm) is
# pure overhead when the caller never wanted it. Used by the automatic
# WORKBENCH_SHOW_FUNCTIONS startup banner (lib/loader.sh) to keep that
# banner to functions + getters only; a manual `wb functions` still shows
# every section by default.
#
# --compact (docs/decisions-log.md D86) replaces each "available once
# tooling is installed" block with a one-line count, so that same banner
# stays short even on a host missing several tools. It applies to this
# top-level listing only: a module's own getter never sets it.
_wb_cmd_functions_impl() {
    local name reglist filepath tier base manifest
    local -a eager_files=()
    local any_getters="false"
    local -a _getter_lines=()
    local _wb_fn_arg _wb_fn_no_aliases="false"
    # Read by _wb_print_unavailable_block (lib/core/functions.sh) through
    # bash's dynamic scoping: a local here is visible to every function this
    # one calls, and gone when it returns.
    # shellcheck disable=SC2034
    local _wb_functions_compact="false"
    for _wb_fn_arg in "$@"; do
        case "${_wb_fn_arg}" in
            --no-aliases) _wb_fn_no_aliases="true" ;;
            --compact) _wb_functions_compact="true" ;;
        esac
    done

    while IFS= read -r name; do
        [[ -z "${name}" ]] && continue

        reglist="$(workbench_module_dir "${name}")/register.list"
        if [[ -f "${reglist}" ]]; then
            while IFS='|' read -r filepath tier; do
                [[ -z "${filepath}" ]] && continue
                if [[ "${tier}" == "platform" || "${tier}" == "distro" ]]; then
                    base="$(basename "${filepath}" .sh)"
                    _wb_loader_should_source_by_name "${tier}" "${base}" || continue
                fi
                eager_files+=("${filepath}")
            done < "${reglist}"
        fi

        manifest="$(workbench_resolve_manifest_path "$(workbench_module_current_dir "${name}")")"
        [[ -f "${manifest}" ]] || continue
        local getter_name getter_fn getter_label
        while IFS='|' read -r getter_name getter_fn getter_label; do
            [[ -z "${getter_name}" ]] && continue
            any_getters="true"
            _getter_lines+=("$(printf '  %-22s %s' "${getter_fn}" "${getter_label}")")
        done < <(workbench_manifest_register_getter_entries "${manifest}")
    done < <(workbench_list_loadable_modules)

    # ── Snapshot the live function/alias table before sourcing, so what's
    # "new" after sourcing can be read straight from shell state instead
    # of grepping the files a second time. Known, accepted limitation: a
    # module function that happens to share a name with something
    # already defined by bin/wb's own lib files (naming conventions make
    # this collision unlikely in practice — module functions are things
    # like gpg-list/git-cleanup, core internals are workbench_*/_wb_*)
    # would not show as "new" here even though it genuinely loaded, since
    # it redefines rather than adds a name. Flagged, not fixed — the old
    # static-grep approach didn't have this gap but paid for a second
    # file read on every single name to avoid it.
    local _before_functions _before_aliases
    _before_functions="$(declare -F | sed 's/^declare -f //')"
    if [[ "${_wb_fn_no_aliases}" == "false" ]]; then
        _before_aliases="$(alias -p 2>/dev/null | sed -E 's/^alias ([a-zA-Z0-9_-]+)=.*/\1/')"
    fi

    # ── Source eager_files once so any "_<name>-available" predicates they
    # declare (docs/module-authoring.md "Declaring function availability")
    # are callable by _wb_filter_available_names below. A module's own
    # getter runs inside the interactive shell, where the loader has
    # already sourced everything, so it needs nothing extra — this step
    # exists only for `wb functions` itself, which runs as its own
    # subprocess and has sourced nothing yet. Output is discarded, not
    # just errors — a file that unconditionally echoes or log_infos at
    # source time must not leak into this command's own formatted
    # listing. A file that fails to source is skipped, not fatal.
    # ${#eager_files[@]} -gt 0 guards the loop itself, not just its body:
    # bash 3.2 (macOS's default /bin/bash) treats "${eager_files[@]}" on a
    # genuinely empty array as an unbound-variable error under this file's
    # own `set -u` (line 9) — a real, reachable case here, since
    # eager_files is legitimately empty on a fresh host before its first
    # `wb apply`. set +u/-u around the sourcing itself, not just the array
    # guard above: every module's shell/*.sh is written and tested only
    # against lib/loader.sh's own sourcing, which never sets -u — an
    # unquoted reference to a genuinely-unset var (e.g. a bare
    # "${DISPLAY}") is completely fine there, but fatal under this file's
    # own nounset (confirmed regression: workbench-shell's
    # shell/editors.sh, workbench-gpg#7-adjacent). `|| true` guards a
    # file's own command failures; it cannot catch that, since the shell
    # is gone before it would run.
    if [[ ${#eager_files[@]} -gt 0 ]]; then
        local _src_file
        set +u
        for _src_file in "${eager_files[@]}"; do
            # shellcheck disable=SC1090
            source "${_src_file}" &>/dev/null || true
        done
        set -u
    fi

    if [[ ${#eager_files[@]} -eq 0 ]]; then
        echo
        echo "[INFO] Loaded functions:"
        echo "  (none — no module has rendered register.list yet; run 'wb apply')"
    else
        local _after_functions _new_functions
        _after_functions="$(declare -F | sed 's/^declare -f //')"
        _new_functions="$(comm -13 <(sort <<< "${_before_functions}") <(sort <<< "${_after_functions}") | grep -v '^_')"
        _wb_print_live_names "Loaded functions" "${_new_functions}"

        if [[ "${_wb_fn_no_aliases}" == "false" ]]; then
            local _after_aliases _new_aliases
            _after_aliases="$(alias -p 2>/dev/null | sed -E 's/^alias ([a-zA-Z0-9_-]+)=.*/\1/')"
            _new_aliases="$(comm -13 <(sort <<< "${_before_aliases}") <(sort <<< "${_after_aliases}"))"
            _wb_print_live_names "Loaded aliases" "${_new_aliases}"
        fi
    fi

    echo
    echo "[INFO] Getters — run any of these for full detail on that area:"
    if [[ "${any_getters}" == "true" ]]; then
        printf '%s\n' "${_getter_lines[@]}"
    else
        echo "  (none registered yet)"
    fi
    echo
    _wb_print_timeout_warning
}

# ── tools ──────────────────────────────────────────────────────────────────
# The tool-updating framework's CLI surface (docs/decisions-log.md D23,
# baseline-completion brief §Phase 3). Discovery (workbench_tools_collect/
# workbench_tools_lookup, lib/core/tools.sh) is entirely generic — core has
# no idea how any individual tool is installed, checked, or updated. Manual
# only: never invoked from 'wb sync run-if-due'/the background timer.
_wb_cmd_tools_list() {
    local show_status="false"
    case "${1:-}" in
        --status) show_status="true" ;;
    esac

    local name abs_path func friendly current_module="" any="false" status
    echo
    echo "[INFO] Discovered install-* tools, by module:"
    echo "  Run 'wb tools install <name>' (or 'wb tools upgrade <name>') using the name"
    echo "  in the left column below — the right column is the underlying function name,"
    echo "  not something to type directly."
    if [[ "${show_status}" == "false" ]]; then
        echo "  Pass --status to also show whether each tool is already installed"
        echo "  (requires the owning module to implement installed-<name> — see"
        echo "  docs/module-authoring.md)."
    fi
    while IFS='|' read -r name abs_path func friendly; do
        [[ -z "${friendly}" ]] && continue
        any="true"
        if [[ "${name}" != "${current_module}" ]]; then
            echo
            echo "  ${name}:"
            current_module="${name}"
        fi
        if [[ "${show_status}" == "true" ]]; then
            status="$(_wb_tools_check_installed "${name}" "${abs_path}" "${func}" "${friendly}")"
            printf '    %-24s %-24s %s\n' "${friendly}" "${func}" "${status}"
        else
            printf '    %-24s %s\n' "${friendly}" "${func}"
        fi
    done < <(workbench_tools_collect)
    [[ "${any}" == "false" ]] && echo "  (none discovered)"
    echo
}

# _wb_tools_invoke <verb> <module> <abs-path> <function> <friendly-name>
# Sources <abs-path> only if <function> isn't already defined in this
# shell, then calls it exactly once. Idempotency/version-checking is
# entirely the function's own responsibility (docs/module-authoring.md) —
# core calls it and reports what it does, nothing more; there is no
# aggregate "all up to date" summary, since core has no way to know that.
# <verb> is "update" or "install" — cosmetic only, so log output echoes
# back whichever one the caller actually typed rather than always saying
# "update" under the install alias (docs/decisions-log.md D41).
_wb_tools_invoke() {
    local verb="$1" name="$2" abs_path="$3" func="$4" friendly="$5"

    # Core API installer helpers (_wb_gh_asset_digest, _wb_fetch_verified,
    # _download_file_robust, ...) are promised to every install-* function
    # (docs/decisions-log.md D34). bin/wb does not load them at startup, so
    # require them here, before the module's file is sourced and called.
    _wb_require core/installers-common.sh

    # D93: each installer runs in its own subshell with errexit, nounset and
    # pipefail off. Module installers are written for an interactive shell,
    # which sets none of them; under this file's `set -u` an unbound
    # variable, or an installer's own `exit`, would end the whole wb process
    # and every tool after it in an `all` run. Sourcing happens inside the
    # subshell too: a file can trip nounset at source time.
    (
        set +e +u +o pipefail
        if ! command -v "${func}" &>/dev/null; then
            if [[ ! -f "${abs_path}" ]]; then
                log_error "wb tools ${verb}: ${friendly} (${name}): installer file not found: ${abs_path}"
                exit 1
            fi
            # shellcheck disable=SC1090
            source "${abs_path}"
        fi

        if ! command -v "${func}" &>/dev/null; then
            log_error "wb tools ${verb}: ${friendly} (${name}): '${func}' is not a function after sourcing ${abs_path}"
            exit 1
        fi

        log_info "wb tools ${verb}: ${friendly} (${name}): running ${func}..."
        "${func}"
    )
}

# _wb_tools_check_installed <module> <abs-path> <install-func> <friendly-name>
# Looks for an optional installed-<friendly> predicate declared in the
# same file as <install-func>, sources that file if not already loaded
# (identical lazy-source-on-demand as _wb_tools_invoke), calls it, and
# prints exactly one of: installed | not-installed | unresponsive.
#
# Contract (docs/module-authoring.md "Reporting install status"): a
# module MAY declare installed-<name> alongside install-<name>. Exit 0
# means installed, exit 1 means not installed; anything else — a
# different exit code, a crash, or simply not declaring the predicate at
# all — is "unresponsive", deliberately never guessed either way, since
# a wrong guess in either direction is worse than an honest "don't know"
# (docs/decisions-log.md D43). Never itself returns non-zero; this is a
# status query, not an action, and every caller treats all three outcomes
# as valid, expected results.
_wb_tools_check_installed() {
    # shellcheck disable=SC2034  # install_func: kept for call-signature
    # symmetry with _wb_tools_invoke's <verb> <module> <abs-path> <function>
    # <friendly-name>; this function only needs abs_path/friendly.
    local name="$1" abs_path="$2" install_func="$3" friendly="$4"
    local predicate="installed-${friendly}"

    # D93: same isolation as _wb_tools_invoke — a predicate (or its file)
    # that trips nounset or calls `exit` must not end the wb process.
    (
        set +e +u +o pipefail
        if ! command -v "${predicate}" &>/dev/null && [[ -f "${abs_path}" ]]; then
            # shellcheck disable=SC1090
            source "${abs_path}"
        fi

        if ! command -v "${predicate}" &>/dev/null; then
            echo "unresponsive"
            exit 0
        fi

        "${predicate}" &>/dev/null
        rc=$?
        case "${rc}" in
            0) echo "installed" ;;
            1) echo "not-installed" ;;
            *) echo "unresponsive" ;;
        esac
    )
}

# _wb_cmd_tools_install <name>|all
# 'install' always runs install-<name>, first-time or not — no target and
# no bare invocation are accepted; you must say what you mean
# (docs/decisions-log.md D43 — "never install something unless specifically
# directed to"). 'all' is the one way to mean "everything discovered",
# and is itself gated behind printing the full list and a plain-stdin
# y/N confirmation — plain `read -r`, not _read_prompt's /dev/tty read,
# matching lib/modules/dev.sh's existing precedent: this is a top-level
# interactive command a human runs directly, not a provisioning-script
# context. No/empty/EOF input all abort cleanly with nothing run.
_wb_cmd_tools_install() {
    local target="${1:-}"

    if [[ -z "${target}" ]]; then
        log_error "wb tools install: usage: wb tools install <name>|all — install never runs without an explicit target."
        return 2
    fi

    if [[ "${target}" != "all" ]]; then
        local hit name abs_path func
        hit="$(workbench_tools_lookup "${target}")" || {
            log_error "wb tools install: no discovered installer named '${target}' — see 'wb tools list'"
            return 1
        }
        IFS='|' read -r name abs_path func <<< "${hit}"
        _wb_tools_invoke "install" "${name}" "${abs_path}" "${func}" "${target}"
        return $?
    fi

    local name abs_path func friendly any="false"
    echo
    echo "[INFO] About to install ALL of the following discovered tools:"
    while IFS='|' read -r name abs_path func friendly; do
        [[ -z "${friendly}" ]] && continue
        any="true"
        printf '    %-24s (%s)\n' "${friendly}" "${name}"
    done < <(workbench_tools_collect)
    echo

    if [[ "${any}" == "false" ]]; then
        log_info "wb tools install: nothing discovered — nothing to do."
        return 0
    fi

    local answer
    printf 'Proceed with all of the above? [y/N]: '
    if ! read -r answer; then
        echo
        log_info "wb tools install: aborted (no input) — nothing was installed."
        return 0
    fi
    case "${answer}" in
        y|Y|yes|YES) ;;
        *)
            log_info "wb tools install: aborted — nothing was installed."
            return 0
            ;;
    esac

    local failures=0 failed_names="" rc
    # fd 3, not stdin: an installer that reads stdin (a prompt, a package
    # manager without -y) must not swallow the rest of the tool list.
    while IFS='|' read -r name abs_path func friendly <&3; do
        [[ -z "${friendly}" ]] && continue
        _wb_tools_invoke "install" "${name}" "${abs_path}" "${func}" "${friendly}"
        rc=$?
        if [[ "${rc}" -ne 0 ]]; then
            log_error "wb tools install: ${friendly} (${name}): failed (exit ${rc})"
            failures=$((failures + 1))
            failed_names="${failed_names} ${friendly}"
        fi
    done 3< <(workbench_tools_collect)
    if [[ "${failures}" -gt 0 ]]; then
        log_error "wb tools install: ${failures} tool(s) failed:${failed_names}"
    fi
    return "${failures}"
}

# _wb_cmd_tools_upgrade [<name>|all]
# Only ever runs install-<name> for a tool whose installed-<name>
# predicate actually reports it's installed (docs/decisions-log.md D43).
# Bare/'all' walk every discovered tool via _wb_tools_check_installed:
#   installed     -> run install-<name> (the actual "upgrade" action)
#   not-installed -> dropped silently; unremarkable, most of a fresh
#                     host's discovered tools land here
#   unresponsive  -> never run; counted and listed once at the end, so a
#                     module missing/failing its predicate is visible
#                     instead of either silently ignored or blindly run
# A single <name> target gets the same three-way check, scoped to one
# tool — not-installed/unresponsive are reported and treated as a no-op,
# never an error; only a genuine install-<name> failure is.
_wb_cmd_tools_upgrade() {
    local target="${1:-}"

    if [[ -n "${target}" && "${target}" != "all" ]]; then
        local hit name abs_path func friendly status
        hit="$(workbench_tools_lookup "${target}")" || {
            log_error "wb tools upgrade: no discovered installer named '${target}' — see 'wb tools list'"
            return 1
        }
        IFS='|' read -r name abs_path func <<< "${hit}"
        # workbench_tools_lookup accepts both the friendly name and the
        # install-<name> fallback spelling (docs/decisions-log.md D41), but
        # only ever returns module|abs_path|func — the installed-<name>
        # predicate is keyed on the friendly name, so it must be derived
        # from func here rather than reusing the raw, possibly-fallback
        # ${target}: passing "install-terraform" straight through would
        # look for a nonexistent installed-install-terraform predicate
        # and always report unresponsive.
        friendly="${func#install-}"
        status="$(_wb_tools_check_installed "${name}" "${abs_path}" "${func}" "${friendly}")"
        case "${status}" in
            installed)
                _wb_tools_invoke "upgrade" "${name}" "${abs_path}" "${func}" "${friendly}"
                return $?
                ;;
            not-installed)
                log_info "wb tools upgrade: ${friendly} (${name}): not installed — nothing to upgrade."
                return 0
                ;;
            *)
                log_warn "wb tools upgrade: ${friendly} (${name}): status unresponsive — module doesn't implement installed-${friendly}, or the check failed. Skipped."
                return 0
                ;;
        esac
    fi

    local name abs_path func friendly status any="false"
    local upgraded_count=0 failed_count=0 unresponsive_count=0 unresponsive_names=""
    # fd 3, not stdin: an installer that reads stdin (a prompt, a package
    # manager without -y) must not swallow the rest of the tool list.
    while IFS='|' read -r name abs_path func friendly <&3; do
        [[ -z "${friendly}" ]] && continue
        any="true"
        status="$(_wb_tools_check_installed "${name}" "${abs_path}" "${func}" "${friendly}")"
        case "${status}" in
            installed)
                if _wb_tools_invoke "upgrade" "${name}" "${abs_path}" "${func}" "${friendly}"; then
                    upgraded_count=$((upgraded_count + 1))
                else
                    log_error "wb tools upgrade: ${friendly} (${name}): failed"
                    failed_count=$((failed_count + 1))
                fi
                ;;
            not-installed)
                : # dropped from further consideration — expected, not worth reporting
                ;;
            *)
                unresponsive_count=$((unresponsive_count + 1))
                unresponsive_names="${unresponsive_names}    ${friendly} (${name})
"
                ;;
        esac
    done 3< <(workbench_tools_collect)

    if [[ "${any}" == "false" ]]; then
        log_info "wb tools upgrade: nothing discovered — nothing to do."
        return 0
    fi

    echo
    if [[ "${failed_count}" -gt 0 ]]; then
        echo "[INFO] wb tools upgrade: ${upgraded_count} tool(s) upgraded, ${failed_count} failed."
    else
        echo "[INFO] wb tools upgrade: ${upgraded_count} tool(s) upgraded."
    fi
    if [[ "${unresponsive_count}" -gt 0 ]]; then
        echo "[INFO] wb tools upgrade: ${unresponsive_count} tool(s) skipped as unresponsive (no installed-<name> predicate, or it failed) — no-op:"
        printf '%s' "${unresponsive_names}"
    fi
    echo
    return "${failed_count}"
}

_wb_cmd_tools() {
    local sub="${1:-list}"
    [[ $# -gt 0 ]] && shift
    case "${sub}" in
        list)      _wb_cmd_tools_list "$@" ;;
        install)   _wb_cmd_tools_install "$@" ;;
        upgrade)   _wb_cmd_tools_upgrade "$@" ;;
        *)
            log_error "wb tools: usage: wb tools [list [--status]] | wb tools install <name>|all | wb tools upgrade [<name>|all]"
            return 2
            ;;
    esac
}

# ── module info / docs (docs/decisions-log.md D45) ───────────────────────────
# Read-only, module-published metadata — distinct from 'wb status' (sync/
# tracking state core tracks regardless of what a module publishes) and
# from 'wb help <command>' (this CLI's own usage text, not a module's
# self-description).
_wb_cmd_module_info() {
    local name="${1:-}"
    if [[ -z "${name}" ]]; then
        log_error "wb module info: usage: wb module info <name>"
        return 2
    fi
    if ! workbench_is_registered "${name}"; then
        log_error "wb module info: '${name}' is not registered — run 'wb add ${name}' first"
        return 1
    fi

    local current_dir manifest
    current_dir="$(workbench_module_current_dir "${name}")"
    if [[ ! -d "${current_dir}" ]]; then
        log_error "wb module info: '${name}' is registered but has never been synced — run 'wb update ${name}' first"
        return 1
    fi
    manifest="$(workbench_resolve_manifest_path "${current_dir}")"

    local repo_url private_flag visibility mode ref sha enabled registered core_api description

    repo_url="$(workbench_module_conf_get "${name}" REPO_URL "")"
    private_flag="$(workbench_module_conf_get "${name}" PRIVATE false)"
    visibility="public"
    [[ "${private_flag}" == "true" ]] && visibility="private"

    mode="$(workbench_module_conf_get "${name}" TRACK_MODE latest)"
    ref="$(workbench_module_conf_get "${name}" TRACK_REF "")"
    sha="$(workbench_module_conf_get "${name}" RESOLVED_SHA "")"
    enabled="$(workbench_module_conf_get "${name}" SYNC_ENABLED true)"
    registered="$(workbench_module_conf_get "${name}" REGISTERED true)"
    core_api="$(workbench_manifest_scalar core_api "${manifest}")"
    description="$(workbench_manifest_info_description "${manifest}")"

    echo
    echo "Module: ${name}"
    printf '  %-15s %s (%s)\n' "Repository:" "${repo_url:-unknown}" "${visibility}"
    if [[ -n "${description}" ]]; then
        printf '  %-15s %s\n' "Description:" "${description}"
    else
        printf '  %-15s %s\n' "Description:" "not published yet — see the repository above for more"
    fi
    if [[ -n "${ref}" ]]; then
        printf '  %-15s %s (%s)\n' "Tracking:" "${mode}" "${ref}"
    else
        printf '  %-15s %s\n' "Tracking:" "${mode}"
    fi
    printf '  %-15s %s\n' "Resolved SHA:" "${sha:-none yet}"
    printf '  %-15s %s\n' "Core API:" "${core_api:-not declared}"
    printf '  %-15s %s\n' "Registered:" "${registered}"
    printf '  %-15s %s\n' "Sync enabled:" "${enabled}"
    echo
    echo "Run 'wb module docs ${name}' for any further documentation this module publishes."
    echo
}

_wb_cmd_module_docs() {
    local name="${1:-}"
    if [[ -z "${name}" ]]; then
        log_error "wb module docs: usage: wb module docs <name>"
        return 2
    fi
    if ! workbench_is_registered "${name}"; then
        log_error "wb module docs: '${name}' is not registered — run 'wb add ${name}' first"
        return 1
    fi

    local current_dir
    current_dir="$(workbench_module_current_dir "${name}")"
    if [[ ! -d "${current_dir}" ]]; then
        log_error "wb module docs: '${name}' is registered but has never been synced — run 'wb update ${name}' first"
        return 1
    fi

    local docs_file
    if docs_file="$(workbench_module_docs_path "${name}")"; then
        echo
        echo "== ${name}: $(basename "${docs_file}") =="
        echo
        cat "${docs_file}"
        echo
        return 0
    fi

    local repo_url
    repo_url="$(workbench_module_conf_get "${name}" REPO_URL "")"
    echo
    echo "'${name}' hasn't published additional documentation yet."
    [[ -n "${repo_url}" ]] && echo "See ${repo_url} for more."
    echo
}

# _wb_cmd_module_reset <module> <name>|all [--follow] [--yes]
# D51's command, kept for anyone used to it: since D81 it is exactly
# 'wb files use' — same arguments, same matching, same confirmation.
_wb_cmd_module_reset() {
    _wb_cmd_files_use "$@"
}

_wb_cmd_module() {
    _wb_require modules/info.sh
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "${sub}" in
        info)  _wb_cmd_module_info "$@" ;;
        docs)  _wb_cmd_module_docs "$@" ;;
        reset) _wb_cmd_module_reset "$@" ;;
        *)
            log_error "wb module: usage: wb module info <name> | wb module docs <name> | wb module reset <name> <target>|all"
            return 2
            ;;
    esac
}

# ── files (docs/decisions-log.md D81) ───────────────────────────────────────
# The user's view of, and say over, every file a module deploys outside its
# own snapshot. All decisions and every write live in lib/files/lifecycle.sh;
# this layer only resolves names, previews, confirms, and reports.
#
# Shared rules: anything that writes previews first, names the backup root,
# then asks [y/N]. On non-TTY stdin without --yes it refuses (exit 1) and
# changes nothing. Exit codes: 0 success, 1 failure or refusal, 2 usage. A
# run over several targets attempts every one, then exits 1 if any failed.

_wb_files_backup_root() {
    printf '%s/workbench/backups\n' "${XDG_DATA_HOME:-${HOME}/.local/share}"
}

# ~/-form for display; dests are stored that way already, overrides_src's
# engine-computed path isn't.
# shellcheck disable=SC2088  # a literal ~/ for display, never expanded
_wb_files_display_path() {
    local path="$1"
    case "${path}" in
        "${HOME}"/*) printf '~/%s\n' "${path#"${HOME}"/}" ;;
        *)           printf '%s\n' "${path}" ;;
    esac
}

# _wb_files_confirm <yes:true|false> <label>
# 0 = go ahead, 1 = refused (non-TTY without --yes), 2 = the user declined.
_wb_files_confirm() {
    local yes="$1" label="$2" answer
    [[ "${yes}" == "true" ]] && return 0
    if ! _wb_have_tty; then
        log_error "${label}: not running in a terminal — re-run with --yes to confirm. Nothing was changed."
        return 1
    fi
    printf 'Proceed? [y/N]: ' >/dev/tty
    if ! IFS= read -r answer </dev/tty; then
        echo >/dev/tty
        log_info "${label}: aborted — nothing was changed."
        return 2
    fi
    case "${answer}" in
        y|Y|yes|YES) return 0 ;;
    esac
    log_info "${label}: aborted — nothing was changed."
    return 2
}

# _wb_files_require_module <label> <module> [synced]
# The module must be a valid name with state on this host; 'synced' also
# requires a current snapshot (anything that reads the manifest needs one).
_wb_files_require_module() {
    local label="$1" module="$2" need="${3:-}"
    if ! workbench_valid_module_name "${module}"; then
        log_error "${label}: '${module}' is not a valid module name"
        return 2
    fi
    if [[ "${need}" == "synced" ]]; then
        if ! workbench_is_registered "${module}"; then
            log_error "${label}: '${module}' is not registered — run 'wb add ${module}' first"
            return 1
        fi
        if [[ ! -d "$(workbench_module_current_dir "${module}")" ]]; then
            log_error "${label}: '${module}' is registered but has never been synced — run 'wb update ${module}' first"
            return 1
        fi
    elif [[ ! -d "$(workbench_module_dir "${module}")" ]]; then
        log_error "${label}: '${module}' has no state on this host"
        return 1
    fi
    return 0
}

# _wb_files_resolve_target <module> <file> <label> [restore|resolve]
# Prints the one target line (workbench_files_targets) <file> names. Rules
# in order, the first with exactly one match wins:
#   1. exact dest — ~/-form, expanded absolute, or overrides_src's path
#   2. exact basename
#   3. exact src_rel
# Then, for entries no longer in the manifest: 'resolve' falls back to a
# linked ledger row (workbench_files_row_as_target), 'restore' to any
# ledger row by dest or basename (a minimal line: only dest and kind set).
# Zero matches lists the basenames; several list dest (src: ...) — both on
# stderr, since callers capture stdout.
_wb_files_resolve_target() {
    local module="$1" file="$2" label="$3" fallback="${4:-}"
    local entries line base src dest kind row_dest row_kind
    local -a by_dest=() by_base=() by_src=() by_row=() ambiguous=()
    entries="$(workbench_files_targets "${module}" --log)"
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        IFS='|' read -r base src dest kind _ <<< "${line}"
        if [[ "${dest%/}" == "${file%/}" || "$(_wb_expand_dest "${dest%/}")" == "${file%/}" ]]; then
            by_dest+=("${line}")
        fi
        [[ "${base}" == "${file}" ]] && by_base+=("${line}")
        [[ "${src}" == "${file}" ]] && by_src+=("${line}")
    done <<< "${entries}"

    if [[ "${#by_dest[@]}" -eq 1 ]]; then printf '%s\n' "${by_dest[0]}"; return 0; fi
    if [[ "${#by_base[@]}" -eq 1 ]]; then printf '%s\n' "${by_base[0]}"; return 0; fi
    if [[ "${#by_src[@]}" -eq 1 ]]; then printf '%s\n' "${by_src[0]}"; return 0; fi

    if [[ -n "${fallback}" ]]; then
        while IFS='|' read -r row_dest row_kind _; do
            [[ -z "${row_dest}" ]] && continue
            if [[ "${row_dest%/}" == "${file%/}" || "$(_wb_expand_dest "${row_dest%/}")" == "${file%/}" \
                || "$(basename "${row_dest}")" == "${file}" ]]; then
                if [[ "${fallback}" == "resolve" ]]; then
                    line="$(workbench_files_row_as_target "${module}" "${row_dest}")"
                    [[ -n "${line}" ]] && by_row+=("${line}")
                else
                    by_row+=("$(basename "${row_dest}")||${row_dest}|${row_kind}|||ledger|")
                fi
            fi
        done < <(workbench_files_ledger_rows "${module}")
        if [[ "${#by_row[@]}" -eq 1 ]]; then printf '%s\n' "${by_row[0]}"; return 0; fi
    fi

    if [[ "${#by_dest[@]}" -gt 1 ]]; then
        ambiguous=("${by_dest[@]}")
    elif [[ "${#by_base[@]}" -gt 1 ]]; then
        ambiguous=("${by_base[@]}")
    elif [[ "${#by_src[@]}" -gt 1 ]]; then
        ambiguous=("${by_src[@]}")
    elif [[ "${#by_row[@]}" -gt 1 ]]; then
        ambiguous=("${by_row[@]}")
    fi
    if [[ "${#ambiguous[@]}" -gt 0 ]]; then
        log_error "${label}: '${file}' matches more than one of ${module}'s files — name it by its dest instead:"
        for line in "${ambiguous[@]}"; do
            IFS='|' read -r base src dest _ <<< "${line}"
            printf '    %-36s (src: %s)\n' "$(_wb_files_display_path "${dest}")" "${src:--}" >&2
        done
        return 1
    fi
    log_error "${label}: '${file}' doesn't match any of ${module}'s files. Available:"
    printf '%s\n' "${entries}" | awk -F'|' 'NF > 1 && !seen[$1]++ { print "    " $1 }' >&2
    return 1
}

# The target line for <dest>: from the manifest-derived targets, else from a
# linked ledger row whose manifest entry is gone.
_wb_files_line_for_dest() {
    local module="$1" dest="$2" line
    line="$(workbench_files_targets "${module}" | awk -F'|' -v d="${dest}" '$3 == d { print; exit }')"
    [[ -z "${line}" ]] && line="$(workbench_files_row_as_target "${module}" "${dest}")"
    [[ -n "${line}" ]] && printf '%s\n' "${line}"
}

# Prints the yield_to paths of <yield_csv> that exist right now.
_wb_files_existing_yields() {
    local path
    while IFS= read -r path; do
        [[ -z "${path}" ]] && continue
        [[ -e "$(_wb_expand_dest "${path}")" || -L "$(_wb_expand_dest "${path}")" ]] && printf '%s\n' "${path}"
    done < <(printf '%s\n' "$1" | tr ',' '\n')
}

# Prints drift lines indented, for previews and the resolve prompt.
_wb_files_print_drift() {
    local module="$1" dest="$2" src="$3" pin snap
    pin="$(workbench_files_ledger_field "${module}" "${dest}" 7)"
    snap="$(_wb_files_link_snapshot "${module}" "${pin}")"
    workbench_files_snapshot_drift "${module}" "${snap}" "${src}" | sort -k2 | sed 's/^/        /'
}

# _wb_files_module_changed_count <module> <pin> <src_rel>
# How many files the module itself changed at or under <src_rel> between
# the held snapshot and current — from the checksums recorded at fetch, so
# the user's own changes through the link don't count.
_wb_files_module_changed_count() {
    local module="$1" pin="$2" rel="$3" module_dir old new
    module_dir="$(workbench_module_dir "${module}")"
    old="$(workbench_files_sums_path "${module}" "${pin}")"
    new="$(workbench_files_sums_path "${module}" "$(readlink "${module_dir}/current")")"
    if [[ ! -f "${old}" || ! -f "${new}" ]]; then
        printf '?\n'
        return 0
    fi
    awk -v pre="${rel}" '
        function inscope(p) { return pre == "." || p == pre || index(p, pre "/") == 1 }
        FNR == NR { p = substr($0, 67); if (inscope(p)) a[p] = substr($0, 1, 64); next }
        { p = substr($0, 67); if (inscope(p)) b[p] = substr($0, 1, 64) }
        END {
            n = 0
            for (p in a) if (!(p in b) || a[p] != b[p]) n++
            for (p in b) if (!(p in a)) n++
            print n
        }
    ' "${old}" "${new}"
}

# One target's 'wb files use' preview lines (C.5 wording).
_wb_files_preview_use() {
    local module="$1" line="$2" real state original path
    _wb_files_target_fields "${line}"
    if [[ "${WB_T_MODE}" == "layer" ]]; then
        printf '  %s: only workbench'"'"'s block (%s/%s)\n' "$(_wb_files_display_path "${WB_T_DEST%#*}")" "${module}" "${WB_T_BASE}"
        if workbench_layers_target_is_users "${line}"; then
            if [[ -L "$(_wb_expand_dest "${WB_T_DEST%#*}")" ]]; then
                printf '      back up the file your symlink points to, then write through the link\n'
            else
                printf '      back up yours (restore puts it back)\n'
            fi
            workbench_layers_carry_summary "${line}"
        fi
        return 0
    fi
    real="$(_wb_expand_dest "${WB_T_DEST%/}")"
    state="$(workbench_files_ledger_field "${module}" "${WB_T_DEST}" 3)"
    original="$(workbench_files_ledger_field "${module}" "${WB_T_DEST}" 5)"
    if [[ "${WB_T_MODE}" == "copy" ]]; then
        printf '  %s: write the module'"'"'s version\n' "$(_wb_files_display_path "${WB_T_DEST}")"
    else
        printf '  %s: link to the module'"'"'s version\n' "$(_wb_files_display_path "${WB_T_DEST}")"
    fi
    if [[ "${state}" == "held" ]]; then
        printf '      back up your changes:\n'
        _wb_files_print_drift "${module}" "${WB_T_DEST}" "${WB_T_SRC}"
    fi
    while IFS= read -r path; do
        [[ -z "${path}" ]] && continue
        printf '      move %s aside (restore puts it back)\n' "${path}"
    done < <(_wb_files_existing_yields "${WB_T_YIELD}")
    if [[ -e "${real}" || -L "${real}" ]] && ! _wb_files_is_our_link "${module}" "${real}"; then
        if [[ "${WB_T_MODE}" == "copy" && -f "${real}" && ! -L "${real}" ]] && cmp -s "${WB_T_SOURCE}" "${real}"; then
            return 0
        fi
        if [[ "${WB_T_MODE}" != "copy" || -d "${real}" || -L "${real}" ]]; then
            printf '      move %s aside' "$(_wb_files_display_path "${WB_T_DEST}")"
        else
            printf '      back up %s' "$(_wb_files_display_path "${WB_T_DEST}")"
        fi
        if [[ ( -z "${state}" || "${state}" == "user" ) && ( -z "${original}" || "${original}" == "-" ) ]]; then
            printf ' (kept as your original)'
        fi
        printf '\n'
    fi
}

# _wb_files_use_lines <module> <follow:true|false> <yes:true|false> <label> <line>...
# Preview, confirm, then workbench_files_use for each line.
_wb_files_use_lines() {
    local module="$1" follow="$2" yes="$3" label="$4" line rc failed=0 follow_arg=""
    shift 4
    [[ "${follow}" == "true" ]] && follow_arg="follow"
    echo
    echo "${label}: about to use ${module}'s version of:"
    for line in "$@"; do
        _wb_files_preview_use "${module}" "${line}"
    done
    [[ "${follow}" == "true" ]] && echo "  ...and keep following ${module} after you edit them (edits are backed up each time)."
    echo
    echo "Backups go under $(_wb_files_backup_root)/ — the log lines below name each one."
    echo
    _wb_files_confirm "${yes}" "${label}"; rc=$?
    [[ "${rc}" -eq 1 ]] && return 1
    [[ "${rc}" -eq 2 ]] && return 0
    for line in "$@"; do
        workbench_files_use "${module}" "${line}" ${follow_arg:+"${follow_arg}"} || failed=1
    done
    if [[ "${failed}" -eq 1 ]]; then
        log_error "${label}: one or more files failed — see errors above."
        return 1
    fi
    return 0
}

# ── wb files status ─────────────────────────────────────────────────────────

_wb_files_copy_state_label() {
    local policy="$1" condition="$2" action="$3"
    if [[ "${policy}" == "skip" ]]; then printf 'skipped\n'; return 0; fi
    case "${condition}" in
        new)               printf 'not deployed yet\n' ;;
        clean)             printf 'workbench default\n' ;;
        edited)            if [[ "${action}" == "notify" ]]; then printf 'your edits, default changed\n'; else printf 'your edits\n'; fi ;;
        foreign|yielded)   printf 'yours\n' ;;
        user)              printf 'yours (you chose to keep it)\n' ;;
        held)              printf 'changed locally; held\n' ;;
        adoptable)         printf 'older workbench default\n' ;;
        gone|removed)      printf 'removed by you\n' ;;
        restored)          printf 'restored\n' ;;
        *)                 printf '%s\n' "${condition}" ;;
    esac
}

_wb_files_copy_next_label() {
    local condition="$1" action="$2"
    case "${action}" in
        write)          if [[ "${condition}" == "new" ]]; then printf 'create\n'; else printf 'refresh\n'; fi ;;
        write-backup)   printf 'replace (backup first)\n' ;;
        write-original) printf 'replace (yours kept as original)\n' ;;
        write-warn)     printf 'create (yours elsewhere stays)\n' ;;
        adopt)          printf 'adopt as-is\n' ;;
        *)              printf 'leave\n' ;;
    esac
}

# Prints "<state>|<next>" for one linked target.
_wb_files_link_labels() {
    local module="$1" dest="$2" yield="$3" policy="$4" real state
    real="$(_wb_expand_dest "${dest%/}")"
    state="$(workbench_files_ledger_field "${module}" "${dest}" 3)"
    case "${state}" in
        held)     printf 'changed locally; held|waiting on you\n'; return 0 ;;
        user)     printf 'yours (your own copy)|leave\n'; return 0 ;;
        removed)  printf 'removed by you|leave\n'; return 0 ;;
        restored) printf 'restored|leave\n'; return 0 ;;
    esac
    if [[ "${state}" == "active" ]] && _wb_files_is_our_link "${module}" "${real}"; then
        if [[ "${policy}" == "skip" ]]; then
            printf 'linked|becomes your copy\n'
        elif [[ "$(workbench_files_policy_get "${module}" "${dest}")" == "follow" ]]; then
            printf 'linked|backup and follow\n'
        else
            printf 'linked|follows\n'
        fi
        return 0
    fi
    if [[ -e "${real}" || -L "${real}" ]]; then
        printf 'yours|leave\n'
    elif [[ "${policy}" == "skip" || -n "$(_wb_files_existing_yields "${yield}")" ]]; then
        printf 'not deployed yet|leave\n'
    else
        printf 'not deployed yet|link\n'
    fi
}

# _wb_print_table [indent]
# Reads tab-separated rows on stdin, the first one the header, and prints
# them in columns as wide as their widest cell, two spaces apart. The last
# column isn't padded.
_wb_print_table() {
    awk -F'\t' -v indent="${1:-}" '
        {
            rows[NR] = $0
            for (i = 1; i <= NF; i++) {
                if (length($i) > width[i]) width[i] = length($i)
            }
        }
        END {
            for (r = 1; r <= NR; r++) {
                n = split(rows[r], cell, "\t")
                out = indent
                for (i = 1; i < n; i++) out = out sprintf("%-" width[i] "s  ", cell[i])
                print out cell[n]
            }
        }'
}

_wb_cmd_files_status() {
    local module="${1:-}" m line plan policy condition action state next mode_label original star
    local dest reason pending_any=false entry lstate pending_rows="" rows layer_rows
    local -a modules=() layer_lines=()
    _wb_engine_require_files
    if [[ -n "${module}" ]]; then
        _wb_files_require_module "wb files status" "${module}" synced || return $?
        modules=("${module}")
    else
        while IFS= read -r m; do
            [[ -n "${m}" ]] && modules+=("${m}")
        done < <(workbench_list_registered_modules)
    fi
    if [[ "${#modules[@]}" -eq 0 ]]; then
        echo "No modules registered."
        return 0
    fi

    for m in "${modules[@]}"; do
        [[ -d "$(workbench_module_current_dir "${m}")" ]] || continue
        workbench_files_write_pending "${m}"
        [[ -s "$(workbench_files_pending_path "${m}")" ]] || continue
        pending_any=true
        while IFS='|' read -r dest reason; do
            [[ -z "${dest}" ]] && continue
            case "${reason}" in
                held)   reason="changed locally; update held" ;;
                moved)  reason="your edits; default changed" ;;
                linked) reason="a symlink you manage" ;;
            esac
            if [[ "${dest}" == *'#'* ]]; then
                # A layer (D82): named by its layer id.
                line="$(_wb_files_line_for_dest "${m}" "${dest}")"
                pending_rows="${pending_rows}$(printf '%s\t%s\t%s\t%s' "${m}" "$(_wb_files_display_path "${dest%#*}")" "${reason}" \
                    "wb files resolve ${m} ${line%%|*} use|keep")"$'\n'
                continue
            fi
            pending_rows="${pending_rows}$(printf '%s\t%s\t%s\t%s' "${m}" "$(_wb_files_display_path "${dest}")" "${reason}" \
                "wb files resolve ${m} $(basename "${dest%/}")")"$'\n'
        done < "$(workbench_files_pending_path "${m}")"
    done
    if [[ "${pending_any}" == "true" ]]; then
        echo "Waiting on you:"
        printf 'MODULE\tFILE\tWHY\tTO DECIDE\n%s' "${pending_rows}" | _wb_print_table "  "
        echo
    fi

    rows="$(printf 'MODULE\tFILE\tMODE\tPOLICY\tSTATE\tNEXT UPDATE')"$'\n'
    for m in "${modules[@]}"; do
        [[ -d "$(workbench_module_current_dir "${m}")" ]] || continue
        while IFS= read -r line; do
            [[ -z "${line}" ]] && continue
            _wb_files_target_fields "${line}"
            if [[ "${WB_T_MODE}" == "layer" ]]; then
                layer_lines+=("${m}|${line}")
                continue
            fi
            star=""
            [[ -n "$(workbench_files_policy_get "${m}" "${WB_T_DEST}")" ]] && star="*"
            if [[ "${WB_T_MODE}" == "copy" ]]; then
                plan="$(workbench_files_plan "${m}" "${WB_T_DEST}" "${WB_T_SOURCE}" "${WB_T_SRC}" "${WB_T_LIFECYCLE}" "${WB_T_YIELD}")"
                IFS='|' read -r policy condition action <<< "${plan}"
                state="$(_wb_files_copy_state_label "${policy}" "${condition}" "${action}")"
                next="$(_wb_files_copy_next_label "${condition}" "${action}")"
                mode_label="copy"
            else
                policy="$(workbench_files_effective_policy "${m}" "${WB_T_DEST}" link)"
                IFS='|' read -r state next <<< "$(_wb_files_link_labels "${m}" "${WB_T_DEST}" "${WB_T_YIELD}" "${policy}")"
                mode_label="${WB_T_MODE}"
            fi
            original="$(workbench_files_ledger_field "${m}" "${WB_T_DEST}" 5)"
            [[ -n "${original}" && "${original}" != "-" ]] && state="${state} (original kept)"
            rows="${rows}$(printf '%s\t%s\t%s\t%s\t%s\t%s' "${m}" "$(_wb_files_display_path "${WB_T_DEST}")" \
                "${mode_label}" "${policy}${star}" "${state}" "${next}")"$'\n'
        done < <(workbench_files_targets "${m}")
    done
    printf '%s' "${rows}" | _wb_print_table
    if [[ "${#layer_lines[@]}" -gt 0 ]]; then
        echo
        echo "Layers — workbench blocks in your own config files; your settings outside a block win:"
        layer_rows="$(printf 'MODULE\tLAYER\tFILE\tPOSITION\tPOLICY\tSTATE')"$'\n'
        for entry in "${layer_lines[@]}"; do
            m="${entry%%|*}"
            line="${entry#*|}"
            _wb_files_target_fields "${line}"
            lstate="$(workbench_layers_state "${m}" "${line}")"
            policy="$(workbench_files_policy_get "${m}" "${WB_T_BASE}")"
            if [[ -n "${policy}" ]]; then policy="${policy}*"; else policy="managed"; fi
            layer_rows="${layer_rows}$(printf '%s\t%s\t%s\t%s\t%s\t%s' "${m}" "${WB_T_BASE}" "$(_wb_files_display_path "${WB_T_DEST%#*}")" \
                "${WB_T_DEST##*#}" "${policy}" "${lstate}")"$'\n'
        done
        printf '%s' "${layer_rows}" | _wb_print_table
    fi
    echo
    echo "* = a per-file policy ('wb files policy <module> <file> ...')."
    echo "Host default: $(workbench_files_default_policy) — change it with 'wb files policy --default managed|follow'."
}

# ── wb files diff ───────────────────────────────────────────────────────────

# _wb_files_diff_line <module> <target-line> — read-only, always returns 0.
_wb_files_diff_line() {
    local module="$1" line="$2" real state pin left right
    _wb_files_target_fields "${line}"
    if [[ "${WB_T_MODE}" == "layer" ]]; then
        workbench_layers_diff "${module}" "${line}"
        return 0
    fi
    real="$(_wb_expand_dest "${WB_T_DEST%/}")"
    state="$(workbench_files_ledger_field "${module}" "${WB_T_DEST}" 3)"
    if [[ "${WB_T_MODE}" == "copy" ]]; then
        if [[ ! -e "${real}" ]]; then
            log_error "wb files diff: $(_wb_files_display_path "${WB_T_DEST}") doesn't exist — nothing to compare"
            return 1
        fi
        diff -u -L "yours: $(_wb_files_display_path "${WB_T_DEST}")" -L "${module} default" "${real}" "${WB_T_SOURCE}"
        return 0
    fi
    if [[ "${state}" != "held" ]]; then
        echo "$(_wb_files_display_path "${WB_T_DEST}"): linked to ${module}'s version — nothing to compare."
        return 0
    fi
    pin="$(workbench_files_ledger_field "${module}" "${WB_T_DEST}" 7)"
    # Relative to the module's state dir, so diff's headers stay readable:
    # current/<src> is the module now, snapshots/<pin>/<src> is yours.
    if [[ "${WB_T_SRC}" == "." ]]; then
        left="current/"; right="snapshots/${pin}/"
    else
        left="current/${WB_T_SRC}"; right="snapshots/${pin}/${WB_T_SRC}"
    fi
    echo "== Changed locally (since ${pin}) =="
    echo "   (M modified, A added, D deleted — the earlier bytes aren't kept, so this is a list)"
    _wb_files_print_drift "${module}" "${WB_T_DEST}" "${WB_T_SRC}"
    echo
    echo "== Yours vs the module now ('use' would replace this) =="
    echo "   ${left} = ${module} now, ${right} = yours"
    ( cd "$(workbench_module_dir "${module}")" && diff -ru "${left}" "${right}" )
    return 0
}

_wb_cmd_files_diff() {
    local module="${1:-}" file="${2:-}" line
    if [[ -z "${module}" || -z "${file}" ]]; then
        log_error "wb files diff: usage: wb files diff <module> <file>"
        return 2
    fi
    _wb_engine_require_files
    _wb_files_require_module "wb files diff" "${module}" synced || return $?
    line="$(_wb_files_resolve_target "${module}" "${file}" "wb files diff" resolve)" || return 1
    _wb_files_diff_line "${module}" "${line}"
}

# ── wb files use ────────────────────────────────────────────────────────────

_wb_cmd_files_use() {
    local module="" file="" follow=false yes=false line kind
    local -a positional=() chosen=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --follow) follow=true ;;
            --yes|-y) yes=true ;;
            -*) log_error "wb files use: unknown flag '$1'"; return 2 ;;
            *)  positional+=("$1") ;;
        esac
        shift
    done
    [[ "${#positional[@]}" -ge 1 ]] && module="${positional[0]}"
    [[ "${#positional[@]}" -ge 2 ]] && file="${positional[1]}"
    if [[ -z "${module}" || -z "${file}" || "${#positional[@]}" -gt 2 ]]; then
        log_error "wb files use: usage: wb files use <module> <file>|all [--follow] [--yes]"
        return 2
    fi
    _wb_engine_require_files
    _wb_files_require_module "wb files use" "${module}" synced || return $?

    if [[ "${file}" == "all" ]]; then
        # overrides_src is the user's permanently (D48) — only by name.
        while IFS= read -r line; do
            [[ -z "${line}" ]] && continue
            IFS='|' read -r _ _ _ kind _ <<< "${line}"
            [[ "${kind}" == "overrides" ]] && continue
            chosen+=("${line}")
        done < <(workbench_files_targets "${module}" --log)
        if [[ "${#chosen[@]}" -eq 0 ]]; then
            log_info "wb files use: '${module}' deploys no files."
            return 0
        fi
    else
        line="$(_wb_files_resolve_target "${module}" "${file}" "wb files use")" || return 1
        chosen=("${line}")
    fi
    _wb_files_use_lines "${module}" "${follow}" "${yes}" "wb files use" "${chosen[@]}"
}

# ── wb files resolve ────────────────────────────────────────────────────────

# Prints held | moved | linked | none for one target.
_wb_files_wait_kind() {
    local module="$1" line="$2" state
    _wb_files_target_fields "${line}"
    if [[ "${WB_T_MODE}" == "layer" ]]; then
        if [[ "$(workbench_layers_state "${module}" "${line}")" == "linked" ]]; then printf 'layer\n'; else printf 'none\n'; fi
        return 0
    fi
    state="$(workbench_files_ledger_field "${module}" "${WB_T_DEST}" 3)"
    if [[ "${state}" == "held" ]]; then
        printf 'held\n'
    elif [[ "${WB_T_MODE}" == "copy" ]] && \
        [[ "$(workbench_files_plan "${module}" "${WB_T_DEST}" "${WB_T_SOURCE}" "${WB_T_SRC}" "${WB_T_LIFECYCLE}" "${WB_T_YIELD}")" == *"|notify" ]]; then
        printf 'moved\n'
    elif [[ "${WB_T_MODE}" != "copy" && "${state}" == "active" ]] \
        && _wb_files_is_our_link "${module}" "$(_wb_expand_dest "${WB_T_DEST%/}")"; then
        printf 'linked\n'
    else
        printf 'none\n'
    fi
}

_wb_files_choice_text() {
    local module="$1" choice="$2" wait="$3"
    case "${choice}:${wait}" in
        keep:moved)   printf 'stays yours; no further notices\n' ;;
        keep:layer)   printf 'left alone; the layer is skipped\n' ;;
        use:layer)    printf "write %s's block through the symlink\n" "${module}" ;;
        keep:*)       printf 'becomes your own copy; no more updates\n' ;;
        manage:moved) printf "keep yours; you'll hear again when the default changes\n" ;;
        manage:*)     printf 'your changes stay yours; everything else keeps following %s\n' "${module}" ;;
        use:*)        printf "take %s's version (yours is backed up)\n" "${module}" ;;
    esac
}

# _wb_files_resolve_one <module> <line> <choice> <follow:true|false>
# Calls the library and turns its return codes into messages. 0 or 1.
_wb_files_resolve_one() {
    local module="$1" line="$2" choice="$3" follow="$4" rc=0 follow_arg=""
    [[ "${follow}" == "true" ]] && follow_arg="follow"
    _wb_files_target_fields "${line}"
    workbench_files_resolve "${module}" "${line}" "${choice}" ${follow_arg:+"${follow_arg}"} || rc=$?
    case "${rc}" in
        0|4) return 0 ;;
        3)   log_info "wb files resolve: nothing to resolve for $(_wb_files_display_path "${WB_T_DEST}")"; return 0 ;;
        *)   return 1 ;;
    esac
}

# _wb_files_resolve_interactive <module> <line> <wait-kind>
# The keep/manage/use/diff/later prompt. Returns 0 unless the chosen action
# failed.
_wb_files_resolve_interactive() {
    local module="$1" line="$2" wait="$3" answer choice="" pin changed
    _wb_files_target_fields "${line}"
    echo
    echo "${module}: $(_wb_files_display_path "${WB_T_DEST}")"
    case "${wait}" in
        held)
            echo "  Changed locally (M modified, A added, D deleted):"
            _wb_files_print_drift "${module}" "${WB_T_DEST}" "${WB_T_SRC}"
            pin="$(workbench_files_ledger_field "${module}" "${WB_T_DEST}" 7)"
            changed="$(_wb_files_module_changed_count "${module}" "${pin}" "${WB_T_SRC}")"
            echo "  ${module} has changed ${changed} file(s) here since — the update is held until you choose."
            ;;
        moved)
            echo "  You edited it; the module's default has changed since."
            ;;
        linked)
            echo "  Linked to ${module}; nothing is waiting — you can choose ahead of a change."
            ;;
        layer)
            echo "  A symlink you manage (stow, chezmoi, yadm...). ${module} would add its ${WB_T_BASE} block to the file it points to."
            while true; do
                echo
                echo "  [u]se   — add the block, writing through the link (the link stays)"
                echo "  [k]eep  — leave it alone; skip this layer"
                echo "  [d]iff  — show the block, then ask again"
                echo "  [l]ater — decide later"
                printf '  Choice [u/k/d/l]: '
                if ! read -r answer; then
                    echo
                    answer="l"
                fi
                case "${answer}" in
                    u|U|use)      choice="use" ;;
                    k|K|keep)     choice="keep" ;;
                    d|D|diff)     _wb_files_diff_line "${module}" "${line}"; continue ;;
                    l|L|later|"") echo "  Left as it is."; return 0 ;;
                    *)            echo "  Please answer u, k, d or l."; continue ;;
                esac
                break
            done
            _wb_files_resolve_one "${module}" "${line}" "${choice}" false
            return $?
            ;;
    esac
    while true; do
        echo
        echo "  [k]eep mine — mine from now on, no more updates"
        echo "  [m]anage    — keep my changes, keep updating everything else"
        echo "  [u]se       — take the module's version (mine is backed up)"
        echo "  [d]iff      — show the differences, then ask again"
        echo "  [l]ater     — decide later (stays held/pending)"
        printf '  Choice [k/m/u/d/l]: '
        if ! read -r answer; then
            echo
            answer="l"
        fi
        case "${answer}" in
            k|K|keep)    choice="keep" ;;
            m|M|manage)  choice="manage" ;;
            u|U|use)     choice="use" ;;
            d|D|diff)    _wb_files_diff_line "${module}" "${line}"; continue ;;
            l|L|later|"") echo "  Left as it is."; return 0 ;;
            *)           echo "  Please answer k, m, u, d or l."; continue ;;
        esac
        break
    done
    _wb_files_resolve_one "${module}" "${line}" "${choice}" false
}

_wb_cmd_files_resolve() {
    local module="" file="" choice="" follow=false yes=false line dest wait failed=0 rc
    local -a positional=() lines=() waits=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --follow) follow=true ;;
            --yes|-y) yes=true ;;
            -*) log_error "wb files resolve: unknown flag '$1'"; return 2 ;;
            *)  positional+=("$1") ;;
        esac
        shift
    done
    [[ "${#positional[@]}" -ge 1 ]] && module="${positional[0]}"
    [[ "${#positional[@]}" -ge 2 ]] && file="${positional[1]}"
    [[ "${#positional[@]}" -ge 3 ]] && choice="${positional[2]}"
    if [[ -z "${module}" || -z "${file}" || "${#positional[@]}" -gt 3 ]]; then
        log_error "wb files resolve: usage: wb files resolve <module> <file>|all [keep|manage|use] [--follow] [--yes]"
        return 2
    fi
    case "${choice}" in
        ""|keep|manage|use) ;;
        *) log_error "wb files resolve: choice must be keep, manage or use — got '${choice}'"; return 2 ;;
    esac
    if [[ "${follow}" == "true" && "${choice}" != "use" ]]; then
        log_error "wb files resolve: --follow only goes with 'use'"
        return 2
    fi
    if [[ -z "${choice}" ]] && ! _wb_have_tty; then
        log_error "wb files resolve: not running in a terminal — name the choice: wb files resolve ${module} ${file} keep|manage|use [--yes]"
        return 2
    fi
    _wb_engine_require_files
    _wb_files_require_module "wb files resolve" "${module}" synced || return $?

    if [[ "${file}" == "all" ]]; then
        while IFS='|' read -r dest _; do
            [[ -z "${dest}" ]] && continue
            line="$(_wb_files_line_for_dest "${module}" "${dest}")"
            [[ -n "${line}" ]] && lines+=("${line}")
        done < <(workbench_files_pending "${module}")
        if [[ "${#lines[@]}" -eq 0 ]]; then
            log_info "wb files resolve: nothing of ${module}'s is waiting on you."
            return 0
        fi
    else
        line="$(_wb_files_resolve_target "${module}" "${file}" "wb files resolve" resolve)" || return 1
        lines=("${line}")
    fi

    # Keep only what has something to decide; say so for the rest.
    local -a todo=()
    for line in "${lines[@]}"; do
        wait="$(_wb_files_wait_kind "${module}" "${line}")"
        if [[ "${wait}" == "none" || ( "${choice}" == "use" && "${wait}" == "linked" ) ]]; then
            _wb_files_target_fields "${line}"
            # A held entry the user replaced is settled by the library (rc 4)
            # even though it no longer looks like core's link.
            if [[ "$(workbench_files_ledger_field "${module}" "${WB_T_DEST}" 3)" != "held" ]]; then
                log_info "wb files resolve: nothing to resolve for $(_wb_files_display_path "${WB_T_DEST}")"
                continue
            fi
            wait="held"
        fi
        todo+=("${line}")
        waits+=("${wait}")
    done
    [[ "${#todo[@]}" -eq 0 ]] && return 0

    local i=0
    if [[ -z "${choice}" ]]; then
        while [[ "${i}" -lt "${#todo[@]}" ]]; do
            _wb_files_resolve_interactive "${module}" "${todo[${i}]}" "${waits[${i}]}" </dev/tty || failed=1
            i=$((i + 1))
        done
        return "${failed}"
    fi

    echo
    echo "wb files resolve: about to settle:"
    while [[ "${i}" -lt "${#todo[@]}" ]]; do
        _wb_files_target_fields "${todo[${i}]}"
        printf '  %s: %s — %s\n' "$(_wb_files_display_path "${WB_T_DEST}")" "${choice}" \
            "$(_wb_files_choice_text "${module}" "${choice}" "${waits[${i}]}")"
        if [[ "${waits[${i}]}" == "held" && "${choice}" == "use" ]]; then
            printf '      back up your changes:\n'
            _wb_files_print_drift "${module}" "${WB_T_DEST}" "${WB_T_SRC}"
        fi
        i=$((i + 1))
    done
    [[ "${follow}" == "true" ]] && echo "  ...and keep following ${module} after you edit them (edits are backed up each time)."
    echo
    echo "Backups go under $(_wb_files_backup_root)/ — the log lines below name each one."
    echo
    _wb_files_confirm "${yes}" "wb files resolve"; rc=$?
    [[ "${rc}" -eq 1 ]] && return 1
    [[ "${rc}" -eq 2 ]] && return 0
    for line in "${todo[@]}"; do
        _wb_files_resolve_one "${module}" "${line}" "${choice}" "${follow}" || failed=1
    done
    return "${failed}"
}

# _wb_files_prompt_pending
# 'wb update' on a TTY: offer the resolve prompt for everything waiting,
# across every registered module. Never on non-TTY or the scheduled path.
_wb_files_prompt_pending() {
    local m dest line wait
    _wb_have_tty || return 0
    command -v workbench_files_pending &>/dev/null || return 0
    while IFS= read -r m; do
        [[ -z "${m}" ]] && continue
        [[ -s "$(workbench_files_pending_path "${m}")" ]] || continue
        while IFS='|' read -r dest _; do
            [[ -z "${dest}" ]] && continue
            line="$(_wb_files_line_for_dest "${m}" "${dest}")"
            [[ -z "${line}" ]] && continue
            wait="$(_wb_files_wait_kind "${m}" "${line}")"
            [[ "${wait}" == "none" ]] && continue
            _wb_files_resolve_interactive "${m}" "${line}" "${wait}" </dev/tty
        done < <(cat "$(workbench_files_pending_path "${m}")")
    done < <(workbench_list_registered_modules)
}

# ── wb files policy ─────────────────────────────────────────────────────────

_wb_files_policy_list() {
    local m file dest policy any=false
    echo "Host default: $(workbench_files_default_policy)"
    while IFS= read -r m; do
        [[ -z "${m}" ]] && continue
        file="$(workbench_files_policy_path "${m}")"
        [[ -f "${file}" ]] || continue
        while IFS='|' read -r dest policy; do
            [[ -z "${dest}" || "${dest}" == \#* ]] && continue
            if [[ "${any}" == "false" ]]; then
                echo
                printf '%-12s %-36s %s\n' "MODULE" "FILE" "POLICY"
                any=true
            fi
            printf '%-12s %-36s %s\n' "${m}" "$(_wb_files_display_path "${dest}")" "${policy}"
        done < "${file}"
    done < <(workbench_list_registered_modules)
    [[ "${any}" == "false" ]] && echo "No per-file policies set."
    return 0
}

# _wb_files_policy_set_default <managed|follow> <yes>
_wb_files_policy_set_default() {
    local value="$1" yes="$2" previous m line plan action real rc failed=0
    local -a apply_m=() apply_l=() stays=()
    previous="$(workbench_files_default_policy)"
    workbench_files_default_policy_set "${value}" || return 1

    while IFS= read -r m; do
        [[ -z "${m}" ]] && continue
        [[ -d "$(workbench_module_current_dir "${m}")" ]] || continue
        while IFS= read -r line; do
            [[ -z "${line}" ]] && continue
            _wb_files_target_fields "${line}"
            [[ "${WB_T_MODE}" == "layer" ]] && continue
            [[ -n "$(workbench_files_policy_get "${m}" "${WB_T_DEST}")" ]] && continue
            if [[ "${WB_T_MODE}" == "copy" ]]; then
                [[ "${WB_T_LIFECYCLE}" == "managed" ]] || continue
                plan="$(workbench_files_plan "${m}" "${WB_T_DEST}" "${WB_T_SOURCE}" "${WB_T_SRC}" "${WB_T_LIFECYCLE}" "${WB_T_YIELD}")"
                action="${plan##*|}"
                case "${action}" in
                    write-backup|write-original) apply_m+=("${m}"); apply_l+=("${line}") ;;
                esac
            elif [[ "${value}" == "follow" ]]; then
                real="$(_wb_expand_dest "${WB_T_DEST%/}")"
                [[ -n "$(workbench_files_ledger_field "${m}" "${WB_T_DEST}" 3)" && \
                    "$(workbench_files_ledger_field "${m}" "${WB_T_DEST}" 3)" != "active" ]] && continue
                if [[ -e "${real}" || -L "${real}" ]] && ! _wb_files_is_our_link "${m}" "${real}"; then
                    if [[ -d "${real}" && ! -L "${real}" ]]; then
                        stays+=("${m}|${WB_T_DEST}")
                    else
                        apply_m+=("${m}"); apply_l+=("${line}")
                    fi
                fi
            fi
        done < <(workbench_files_targets "${m}")
    done < <(workbench_list_registered_modules)

    if [[ "${#apply_l[@]}" -eq 0 ]]; then
        log_info "wb files policy: host default is now '${value}' — nothing changes on disk right now."
        if [[ "${#stays[@]}" -gt 0 ]]; then
            for line in "${stays[@]}"; do
                printf '  %s %s: stays yours — use '"'"'wb files use'"'"' to switch\n' "${line%%|*}" "$(_wb_files_display_path "${line#*|}")"
            done
        fi
        return 0
    fi

    echo
    echo "wb files policy: with the host default '${value}', these change now:"
    local i=0
    while [[ "${i}" -lt "${#apply_l[@]}" ]]; do
        _wb_files_target_fields "${apply_l[${i}]}"
        if [[ "${WB_T_MODE}" == "copy" ]]; then
            printf '  %-12s %s: replace with %s'"'"'s version (yours backed up)\n' "${apply_m[${i}]}" "$(_wb_files_display_path "${WB_T_DEST}")" "${apply_m[${i}]}"
        else
            printf '  %-12s %s: move yours aside, link %s'"'"'s version\n' "${apply_m[${i}]}" "$(_wb_files_display_path "${WB_T_DEST}")" "${apply_m[${i}]}"
        fi
        i=$((i + 1))
    done
    if [[ "${#stays[@]}" -gt 0 ]]; then
        for line in "${stays[@]}"; do
            printf '  %-12s %s: stays yours — use '"'"'wb files use'"'"' to switch\n' "${line%%|*}" "$(_wb_files_display_path "${line#*|}")"
        done
    fi
    echo
    echo "Backups go under $(_wb_files_backup_root)/ — the log lines below name each one."
    echo
    _wb_files_confirm "${yes}" "wb files policy"; rc=$?
    if [[ "${rc}" -ne 0 ]]; then
        workbench_files_default_policy_set "${previous}"
        [[ "${rc}" -eq 1 ]] && return 1
        return 0
    fi
    i=0
    while [[ "${i}" -lt "${#apply_l[@]}" ]]; do
        _wb_files_target_fields "${apply_l[${i}]}"
        if [[ "${WB_T_MODE}" == "copy" ]]; then
            workbench_files_apply "${apply_m[${i}]}" "${WB_T_DEST}" "${WB_T_SOURCE}" "${WB_T_SRC}" "${WB_T_KIND}" "${WB_T_LIFECYCLE}" "${WB_T_YIELD}" || failed=1
        else
            workbench_files_apply_link "${apply_m[${i}]}" "${WB_T_DEST}" "${WB_T_SOURCE}" "${WB_T_SRC}" "${WB_T_KIND}" "${WB_T_YIELD}" || failed=1
        fi
        workbench_files_write_pending "${apply_m[${i}]}"
        i=$((i + 1))
    done
    return "${failed}"
}

# _wb_files_policy_set_one <module> <file> <policy> <yes>
_wb_files_policy_set_one() {
    local module="$1" file="$2" policy="$3" yes="$4" line previous plan action real rc failed=0
    _wb_files_require_module "wb files policy" "${module}" synced || return $?
    line="$(_wb_files_resolve_target "${module}" "${file}" "wb files policy")" || return 1
    _wb_files_target_fields "${line}"
    if [[ "${WB_T_MODE}" == "layer" ]]; then
        _wb_files_policy_set_layer "${module}" "${line}" "${policy}"
        return $?
    fi
    real="$(_wb_expand_dest "${WB_T_DEST%/}")"
    previous="$(workbench_files_policy_get "${module}" "${WB_T_DEST}")"
    [[ -z "${previous}" ]] && previous="default"

    if [[ "${WB_T_MODE}" != "copy" && "${policy}" == "seed" ]]; then
        log_error "wb files policy: 'seed' is for copied files; $(_wb_files_display_path "${WB_T_DEST}") is linked — 'wb files resolve ${module} ${file} keep' gives you your own copy"
        return 1
    fi

    if [[ "${WB_T_MODE}" != "copy" && "${policy}" == "skip" ]] && _wb_files_is_our_link "${module}" "${real}"; then
        echo
        echo "wb files policy: $(_wb_files_display_path "${WB_T_DEST}") becomes your own copy and stops following ${module}."
        echo
        _wb_files_confirm "${yes}" "wb files policy"; rc=$?
        [[ "${rc}" -eq 1 ]] && return 1
        [[ "${rc}" -eq 2 ]] && return 0
        workbench_files_policy_set "${module}" "${WB_T_DEST}" skip || return 1
        workbench_files_apply_link "${module}" "${WB_T_DEST}" "${WB_T_SOURCE}" "${WB_T_SRC}" "${WB_T_KIND}" "${WB_T_YIELD}" || failed=1
        workbench_files_write_pending "${module}"
        return "${failed}"
    fi

    workbench_files_policy_set "${module}" "${WB_T_DEST}" "${policy}" || return 1

    # Apply it now rather than at the module's next release.
    if [[ "${WB_T_MODE}" == "copy" ]]; then
        plan="$(workbench_files_plan "${module}" "${WB_T_DEST}" "${WB_T_SOURCE}" "${WB_T_SRC}" "${WB_T_LIFECYCLE}" "${WB_T_YIELD}")"
        action="${plan##*|}"
        if [[ "${action}" == "write-backup" || "${action}" == "write-original" ]]; then
            echo
            if [[ "${action}" == "write-backup" ]]; then
                echo "wb files policy: $(_wb_files_display_path "${WB_T_DEST}"): your edits are backed up and replaced with ${module}'s version — now, and at every update."
            else
                echo "wb files policy: $(_wb_files_display_path "${WB_T_DEST}"): yours is backed up (kept as your original) and replaced with ${module}'s version."
            fi
            echo
            echo "Backups go under $(_wb_files_backup_root)/ — the log lines below name each one."
            echo
            _wb_files_confirm "${yes}" "wb files policy"; rc=$?
            if [[ "${rc}" -ne 0 ]]; then
                workbench_files_policy_set "${module}" "${WB_T_DEST}" "${previous}"
                [[ "${rc}" -eq 1 ]] && return 1
                return 0
            fi
        fi
        workbench_files_apply "${module}" "${WB_T_DEST}" "${WB_T_SOURCE}" "${WB_T_SRC}" "${WB_T_KIND}" "${WB_T_LIFECYCLE}" "${WB_T_YIELD}" || failed=1
    elif [[ "${policy}" == "follow" ]] && [[ -e "${real}" || -L "${real}" ]] && ! _wb_files_is_our_link "${module}" "${real}"; then
        echo
        echo "wb files policy: $(_wb_files_display_path "${WB_T_DEST}"): yours is moved aside and ${module}'s version linked in its place."
        _wb_files_preview_use "${module}" "${line}"
        echo
        echo "Backups go under $(_wb_files_backup_root)/ — the log lines below name each one."
        echo
        _wb_files_confirm "${yes}" "wb files policy"; rc=$?
        if [[ "${rc}" -ne 0 ]]; then
            workbench_files_policy_set "${module}" "${WB_T_DEST}" "${previous}"
            [[ "${rc}" -eq 1 ]] && return 1
            return 0
        fi
        workbench_files_use "${module}" "${line}" follow || failed=1
    else
        workbench_files_apply_link "${module}" "${WB_T_DEST}" "${WB_T_SOURCE}" "${WB_T_SRC}" "${WB_T_KIND}" "${WB_T_YIELD}" || failed=1
    fi
    workbench_files_write_pending "${module}"
    [[ "${failed}" -eq 0 ]] && log_info "wb files policy: $(_wb_files_display_path "${WB_T_DEST}") is now '${policy}'"
    return "${failed}"
}

# _wb_files_policy_set_layer <module> <target-line> <skip|managed|default>
# A layer's policy is keyed by its layer id (D82) and takes effect now:
# skip removes the block; managed or default writes it again — clearing
# what an earlier skip or restore left in the ledger, but never a block the
# user edited.
_wb_files_policy_set_layer() {
    local module="$1" line="$2" policy="$3" state
    _wb_files_target_fields "${line}"
    case "${policy}" in
        skip|managed|default) ;;
        *)
            log_error "wb files policy: '${policy}' doesn't apply to a layer — skip, managed or default (your own settings outside the block always win)"
            return 1 ;;
    esac
    workbench_files_policy_set "${module}" "${WB_T_BASE}" "${policy}" || return 1
    state="$(workbench_files_ledger_field "${module}" "${WB_T_DEST}" 3)"
    if [[ "${policy}" != "skip" && ( "${state}" == "user" || "${state}" == "restored" ) ]]; then
        _wb_layers_fields "${line}"
        if ! grep -qxF "$(workbench_layers_marker_start "${module}" "${WB_L_TOOL}" "${WB_L_POSITION}")" "${WB_L_REAL}" 2>/dev/null; then
            workbench_files_ledger_delete "${module}" "${WB_T_DEST}"
        fi
    fi
    workbench_layers_apply "${module}" "${WB_T_BASE}" "${line}" || return 1
    workbench_files_write_pending "${module}"
    log_info "wb files policy: ${module} ${WB_T_BASE} is now '${policy}'"
}

_wb_cmd_files_policy() {
    local yes=false default_value=""
    local -a positional=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes|-y) yes=true ;;
            --default)
                if [[ -z "${2:-}" ]]; then
                    log_error "wb files policy: --default requires managed or follow"
                    return 2
                fi
                default_value="$2"; shift
                ;;
            -*) log_error "wb files policy: unknown flag '$1'"; return 2 ;;
            *)  positional+=("$1") ;;
        esac
        shift
    done
    _wb_engine_require_files

    if [[ -n "${default_value}" ]]; then
        case "${default_value}" in
            managed|follow) ;;
            *) log_error "wb files policy: --default must be managed or follow — got '${default_value}'"; return 2 ;;
        esac
        if [[ "${#positional[@]}" -ne 0 ]]; then
            log_error "wb files policy: --default takes no module or file"
            return 2
        fi
        _wb_files_policy_set_default "${default_value}" "${yes}"
        return $?
    fi
    if [[ "${#positional[@]}" -eq 0 ]]; then
        _wb_files_policy_list
        return 0
    fi
    if [[ "${#positional[@]}" -ne 3 ]]; then
        log_error "wb files policy: usage: wb files policy [<module> <file> skip|seed|managed|follow|default] [--default managed|follow] [--yes]"
        return 2
    fi
    case "${positional[2]}" in
        skip|seed|managed|follow|default) ;;
        *) log_error "wb files policy: policy must be skip, seed, managed, follow or default — got '${positional[2]}'"; return 2 ;;
    esac
    _wb_files_policy_set_one "${positional[0]}" "${positional[1]}" "${positional[2]}" "${yes}"
}

# ── wb files restore ────────────────────────────────────────────────────────

_wb_files_preview_restore() {
    local module="$1" dest="$2" row kind state sha original real o p b
    row="$(workbench_files_ledger_get "${module}" "${dest}")"
    IFS='|' read -r _ kind state sha original _ _ <<< "${row}"
    if [[ "${kind}" == "layer" ]]; then
        printf '  %s:\n' "$(_wb_files_display_path "${dest%#*}")"
        printf '      remove workbench'"'"'s %s block (your settings stay)\n' "${dest##*#}"
        if [[ "${original}" == "+created" ]]; then
            printf '      remove the file if nothing else is left in it (workbench created it)\n'
        elif [[ -n "${original}" && "${original}" != "-" ]]; then
            printf '      put back your original from %s\n' "${original}"
        fi
        return 0
    fi
    real="$(_wb_expand_dest "${dest%/}")"
    printf '  %s:\n' "$(_wb_files_display_path "${dest}")"
    [[ "${state}" == "held" ]] && printf '      back up your held changes first\n'
    if [[ "${state}" == "converted" ]]; then
        printf '      restore each file under it; remove the ones workbench created\n'
    elif [[ "${sha}" == link:* ]]; then
        if _wb_files_is_our_link "${module}" "${real}"; then
            printf '      remove (workbench created it)\n'
        elif [[ -e "${real}" || -L "${real}" ]]; then
            printf '      leave yours in place\n'
        fi
    elif [[ -f "${real}" && ! -L "${real}" ]]; then
        printf '      remove (workbench created it; a copy goes to backups)\n'
    elif [[ -e "${real}" || -L "${real}" ]]; then
        printf '      leave yours in place\n'
    fi
    if [[ -n "${original}" && "${original}" != "-" ]]; then
        printf '      put back your original from %s\n' "${original}"
    fi
    if [[ -f "$(workbench_files_displaced_path "${module}")" ]]; then
        while IFS='|' read -r o p b; do
            [[ "${o}" == "${dest}" ]] && printf '      put back %s (from %s)\n' "${p}" "${b}"
        done < <(grep -v '^#' "$(workbench_files_displaced_path "${module}")")
    fi
    return 0
}

# Ledger dests 'restore all' covers: not already the user's or restored,
# not overrides_src (the user's, D48 — only by name), and not a child of a
# converted directory (restoring the directory restores its children).
_wb_files_restore_all_dests() {
    local module="$1"
    workbench_files_ledger_rows "${module}" | awk -F'|' '
        $3 == "converted" { conv[++n] = $1 "/" }
        { rows[++r] = $0 }
        END {
            for (i = 1; i <= r; i++) {
                split(rows[i], f, "|")
                if (f[2] == "overrides" || f[3] == "user" || f[3] == "restored") continue
                child = 0
                for (j = 1; j <= n; j++) if (index(f[1], conv[j]) == 1) child = 1
                if (!child) print f[1]
            }
        }'
}

# _wb_files_restore_run <module> <file>|all <yes> <label>
# 0 done (or nothing to do), 1 failure or refusal, 2 declined.
_wb_files_restore_run() {
    local module="$1" file="$2" yes="$3" label="$4" line dest rc failed=0
    local -a dests=()
    if [[ "${file}" == "all" ]]; then
        while IFS= read -r dest; do
            [[ -n "${dest}" ]] && dests+=("${dest}")
        done < <(_wb_files_restore_all_dests "${module}")
        if [[ "${#dests[@]}" -eq 0 ]]; then
            log_info "${label}: nothing of ${module}'s to restore."
            return 0
        fi
    else
        line="$(_wb_files_resolve_target "${module}" "${file}" "${label}" restore)" || return 1
        IFS='|' read -r _ _ dest _ <<< "${line}"
        if [[ -z "$(workbench_files_ledger_get "${module}" "${dest}")" ]]; then
            log_info "${label}: nothing of workbench's to restore at $(_wb_files_display_path "${dest}")"
            return 0
        fi
        dests=("${dest}")
    fi

    echo
    echo "${label}: about to put back how things were before ${module}:"
    for dest in "${dests[@]}"; do
        _wb_files_preview_restore "${module}" "${dest}"
    done
    echo
    echo "Backups go under $(_wb_files_backup_root)/ — the log lines below name each one."
    echo
    _wb_files_confirm "${yes}" "${label}"; rc=$?
    [[ "${rc}" -ne 0 ]] && return "${rc}"
    for dest in "${dests[@]}"; do
        rc=0
        workbench_files_restore "${module}" "${dest}" || rc=$?
        case "${rc}" in
            0) ;;
            3) log_info "${label}: nothing of workbench's to restore at $(_wb_files_display_path "${dest}")" ;;
            4) ;;
            *) log_error "${label}: $(_wb_files_display_path "${dest}") was not fully restored — see errors above"; failed=1 ;;
        esac
    done
    return "${failed}"
}

_wb_cmd_files_restore() {
    local module="" file="" yes=false rc
    local -a positional=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes|-y) yes=true ;;
            -*) log_error "wb files restore: unknown flag '$1'"; return 2 ;;
            *)  positional+=("$1") ;;
        esac
        shift
    done
    [[ "${#positional[@]}" -ge 1 ]] && module="${positional[0]}"
    [[ "${#positional[@]}" -ge 2 ]] && file="${positional[1]}"
    if [[ -z "${module}" || -z "${file}" || "${#positional[@]}" -gt 2 ]]; then
        log_error "wb files restore: usage: wb files restore <module> <file>|all [--yes]"
        return 2
    fi
    _wb_engine_require_files
    _wb_files_require_module "wb files restore" "${module}" || return $?
    rc=0
    _wb_files_restore_run "${module}" "${file}" "${yes}" "wb files restore" || rc=$?
    [[ "${rc}" -eq 2 ]] && return 0
    return "${rc}"
}

# ── Install-time choice about existing config (docs/decisions-log.md D84) ──
# 'wb add', 'wb install --bundle', bootstrap, and an interactive 'wb update'
# of a module that was fetched but never deployed: one plan across every
# module (workbench_files_install_plan), one question when the user already
# has config any of them would touch, then deploy. Nothing outside
# workbench's own directories is written before the answer. Questions go
# through /dev/tty, so they work under `curl … | bash`; with no terminal
# the answer is always keep — workbench never replaces a file unasked.

# The target lines one plan row stands for: each layer of a layered file,
# or the one deploy entry.
_wb_install_row_lines() {
    local module="$1" id="$2" kind="$3" layer_id
    if [[ "${kind}" == "layer" ]]; then
        while IFS= read -r layer_id; do
            [[ -n "${layer_id}" ]] && workbench_layers_line "${module}" "${layer_id}"
        done < <(printf '%s\n' "${id}" | tr ',' '\n')
    else
        _wb_files_line_for_dest "${module}" "${id}"
    fi
}

# _wb_install_row_diff <module> <id> <kind> <display-path>
# Yours against the module's file, labelled yours/workbench.
_wb_install_row_diff() {
    local module="$1" id="$2" kind="$3" display="$4" line source
    line="$(_wb_install_row_lines "${module}" "${id}" "${kind}" | head -n 1)"
    source="${line##*|}"
    printf '\n== %s %s ==\n' "${module}" "${display}"
    if [[ -d "${source}" ]]; then
        diff -ru "$(_wb_expand_dest "${display%/}")" "${source}"
    else
        diff -u -L "yours: ${display}" -L "workbench: ${module}" "$(_wb_expand_dest "${display%/}")" "${source}"
    fi
    return 0
}

# _wb_install_preview_use <answers-file> — 'use' preview of every row
# answered use (D81's preview lines, plus what's carried over).
_wb_install_preview_use() {
    local module id kind choice line last=""
    while IFS='|' read -r module id kind choice; do
        [[ "${choice}" == "use" ]] || continue
        [[ "${module}" != "${last}" ]] && printf '  [%s]\n' "${module}"
        last="${module}"
        while IFS= read -r line; do
            [[ -n "${line}" ]] && _wb_files_preview_use "${module}" "${line}"
        done < <(_wb_install_row_lines "${module}" "${id}" "${kind}")
    done < "$1"
}

# _wb_install_answer_all <plan-file> <answers-file> <keep|use>
_wb_install_answer_all() {
    awk -F'|' -v c="$3" '$5 == "existing" || $5 == "linked" { print $1 "|" $2 "|" $4 "|" c }' "$1" > "$2"
}

# _wb_install_confirm_use <answers-file> <yes> — preview, then [y/N].
# 0 go, 1 refused (no terminal), 2 declined.
_wb_install_confirm_use() {
    local answers="$1" yes="$2" out=/dev/stdout
    grep -q '|use$' "${answers}" || return 0
    _wb_have_tty && [[ "${yes}" != "true" ]] && out=/dev/tty
    {
        echo
        echo "Use workbench's version — your files are backed up first ('wb files restore' puts them back):"
        _wb_install_preview_use "${answers}"
        echo
        echo "Backups go under $(_wb_files_backup_root)/."
    } > "${out}"
    _wb_files_confirm "${yes}" "use workbench's"
}

# _wb_install_ask <plan-file> <answers-file>
# The question, on /dev/tty. 0 answered (answers written), 3 quit.
_wb_install_ask() {
    local plan="$1" answers="$2" answer default layered files has_git has_ssh
    local module id display kind cond lines choice rc
    default="$(workbench_files_conf_get INSTALL_DEFAULT)"
    [[ "${default}" == "use" ]] || default="keep"
    layered="$(awk -F'|' '($5 == "existing" || $5 == "linked") && $4 == "layer"' "${plan}" | wc -l | tr -d ' ')"
    files="$(awk -F'|' '($5 == "existing" || $5 == "linked") && $4 == "file" { printf "%s%s", (n++ ? ", " : ""), $3 }' "${plan}")"
    has_git=false; has_ssh=false
    grep -qE '\|~/\.gitconfig\|layer\|(existing|linked)\|' "${plan}" && has_git=true
    grep -qE '\|~/\.ssh/config\|layer\|(existing|linked)\|' "${plan}" && has_ssh=true

    while true; do
        {
            echo
            echo "These modules would touch config you already have:"
            echo
            awk -F'|' '$5 == "existing" || $5 == "linked" {
                n = ($6 == "-") ? "" : $6 (($6 == 1) ? " line" : " lines")
                if ($5 == "linked") n = "symlink"
                printf "  %-8s %-30s %-10s %s\n", $1, $3, n, $4
            }' "${plan}"
            echo
            echo "  keep mine        Your files stay as they are."
            if [[ "${layered}" -gt 0 ]]; then
                echo "                   Workbench adds its defaults underneath the ${layered} layered"
                echo "                   file(s) — anything you've set wins."
            fi
            [[ -n "${files}" ]] && echo "                   ${files}: left alone, and workbench's isn't used."
            echo "  use workbench's  Your files are backed up and replaced with workbench's."
            if [[ "${has_git}" == "true" && "${has_ssh}" == "true" ]]; then
                echo "                   Your git identity and your ssh hosts are kept."
            elif [[ "${has_git}" == "true" ]]; then
                echo "                   Your git identity is kept."
            elif [[ "${has_ssh}" == "true" ]]; then
                echo "                   Your ssh hosts are kept."
            fi
            echo
            if [[ "${default}" == "use" ]]; then
                echo "  [k] keep mine   [u] use workbench's (default)   [c] choose per file"
            else
                echo "  [k] keep mine (default)   [u] use workbench's   [c] choose per file"
            fi
            echo "  [d] show differences      [q] quit — change nothing"
            printf '> '
        } > /dev/tty
        IFS= read -r answer </dev/tty || answer="q"
        [[ -z "${answer}" ]] && answer="${default:0:1}"
        case "${answer}" in
            k|K|keep)
                _wb_install_answer_all "${plan}" "${answers}" keep
                workbench_files_conf_set INSTALL_DEFAULT keep
                return 0
                ;;
            u|U|use)
                _wb_install_answer_all "${plan}" "${answers}" use
                rc=0; _wb_install_confirm_use "${answers}" false || rc=$?
                [[ "${rc}" -eq 0 ]] || continue
                workbench_files_conf_set INSTALL_DEFAULT use
                return 0
                ;;
            c|C)
                : > "${answers}"
                while IFS='|' read -r module id display kind cond lines; do
                    [[ "${cond}" == "existing" || "${cond}" == "linked" ]] || continue
                    while true; do
                        printf '\n  %s %s (%s): [k] keep  [u] use  [s] skip — leave this file completely alone  [d] diff\n  > ' \
                            "${module}" "${display}" "${kind}" > /dev/tty
                        IFS= read -r choice </dev/tty || choice="k"
                        case "${choice}" in
                            ""|k|K) choice="keep" ;;
                            u|U)    choice="use" ;;
                            s|S)    choice="skip" ;;
                            d|D)    _wb_install_row_diff "${module}" "${id}" "${kind}" "${display}" | _wb_maybe_page > /dev/tty; continue ;;
                            *)      echo "  Please answer k, u, s or d." > /dev/tty; continue ;;
                        esac
                        break
                    done
                    printf '%s|%s|%s|%s\n' "${module}" "${id}" "${kind}" "${choice}" >> "${answers}"
                done < "${plan}"
                rc=0; _wb_install_confirm_use "${answers}" false || rc=$?
                [[ "${rc}" -eq 0 ]] || continue
                return 0
                ;;
            d|D)
                awk -F'|' '$5 == "existing" || $5 == "linked"' "${plan}" | while IFS='|' read -r module id display kind cond lines; do
                    _wb_install_row_diff "${module}" "${id}" "${kind}" "${display}"
                done | _wb_maybe_page > /dev/tty
                ;;
            q|Q|quit)
                return 3
                ;;
            *)
                echo "  Please answer k, u, c, d or q." > /dev/tty
                ;;
        esac
    done
}

# _wb_install_summary <plan-file> <answers-file> <module>...
_wb_install_summary() {
    local plan="$1" answers="$2" m module id display kind cond lines choice what original line
    shift 2
    echo
    for m in "$@"; do
        what=""
        while IFS='|' read -r module id display kind cond lines; do
            [[ "${module}" == "${m}" ]] || continue
            choice="$(awk -F'|' -v m="${module}" -v i="${id}" '$1 == m && $2 == i { print $4; exit }' "${answers}")"
            case "${cond}:${choice:-keep}" in
                new:*)
                    if [[ "${kind}" == "layer" ]]; then what="${what}; created ${display} (workbench block)"; else what="${what}; created ${display}"; fi ;;
                ours:*)  ;;
                *:use)
                    line="$(_wb_install_row_lines "${module}" "${id}" "${kind}" | head -n 1)"
                    _wb_files_target_fields "${line}"
                    original="$(workbench_files_ledger_field "${module}" "${WB_T_DEST}" 5)"
                    if [[ -n "${original}" && "${original}" != "-" && "${original}" != "+created" ]]; then
                        what="${what}; replaced ${display} (yours: ${original})"
                    else
                        what="${what}; replaced ${display}"
                    fi ;;
                *:skip)  what="${what}; skipped ${display}" ;;
                *:keep)
                    if [[ "${kind}" == "layer" ]]; then what="${what}; layered ${display} (yours wins)"; else what="${what}; left yours: ${display}"; fi ;;
            esac
        done < "${plan}"
        [[ -n "${what}" ]] && printf '  %s: %s\n' "${m}" "${what#; }"
    done
    echo "  Change any of this later: 'wb files status', 'wb files use|restore <module> <file>'."
}

# _wb_install_modules <ask|keep|use> <follow> <yes> <reason> <module>...
# The modules are registered and staged (workbench_sync_module … stage).
# Returns 0 when deployed, 3 when the user quit (nothing deployed; the
# modules stay registered and the next interactive 'wb update' asks again).
_wb_install_modules() {
    local mode="$1" follow="$2" yes="$3" reason="$4" m rc=0 failed=0 work
    local module id kind choice line follow_arg=""
    shift 4
    local -a mods=()
    for m in "$@"; do
        [[ -d "$(workbench_module_current_dir "${m}")" ]] && mods+=("${m}")
    done
    [[ "${#mods[@]}" -eq 0 ]] && return 0
    _wb_engine_require_files
    [[ "${follow}" == "true" ]] && follow_arg="follow"
    work="$(mktemp -d "${TMPDIR:-/tmp}/wb-install.XXXXXX")" || return 1
    workbench_files_install_plan "${mods[@]}" > "${work}/plan"
    : > "${work}/answers"

    if grep -qE '\|(existing|linked)\|[^|]*$' "${work}/plan"; then
        case "${mode}" in
            keep)
                _wb_install_answer_all "${work}/plan" "${work}/answers" keep ;;
            use)
                _wb_install_answer_all "${work}/plan" "${work}/answers" use
                _wb_install_confirm_use "${work}/answers" "${yes}" || rc=$?
                if [[ "${rc}" -eq 1 ]]; then
                    rm -rf "${work}"; return 1
                elif [[ "${rc}" -eq 2 ]]; then
                    rc=0; _wb_install_ask "${work}/plan" "${work}/answers" || rc=$?
                fi ;;
            *)
                if _wb_have_tty; then
                    _wb_install_ask "${work}/plan" "${work}/answers" || rc=$?
                else
                    log_info "No terminal to ask in — keeping every file you already have; workbench layers its defaults underneath. ('wb files use' switches one later.)"
                    _wb_install_answer_all "${work}/plan" "${work}/answers" keep
                fi ;;
        esac
    fi
    if [[ "${rc}" -eq 3 ]]; then
        log_info "Quit — nothing outside workbench's own folders was changed. Registered but not deployed: ${mods[*]} — 'wb update' asks again."
        rm -rf "${work}"
        return 3
    fi

    # Answers become policy before anything is written: skip is a policy
    # row (a layer's keyed by its id); use runs after the deploy.
    while IFS='|' read -r module id kind choice; do
        [[ "${choice}" == "skip" ]] || continue
        if [[ "${kind}" == "layer" ]]; then
            while IFS= read -r line; do
                [[ -n "${line}" ]] && workbench_files_policy_set "${module}" "${line}" skip
            done < <(printf '%s\n' "${id}" | tr ',' '\n')
        else
            workbench_files_policy_set "${module}" "${id}" skip
        fi
    done < "${work}/answers"

    for m in "${mods[@]}"; do
        workbench_sync_module "${m}" "${reason}" || { log_warn "${m}: deploy didn't complete — see above"; failed=1; }
    done

    while IFS='|' read -r module id kind choice; do
        [[ "${choice}" == "use" ]] || continue
        _wb_files_clear_restored "${module}"
        while IFS= read -r line; do
            [[ -z "${line}" ]] && continue
            workbench_files_use "${module}" "${line}" ${follow_arg:+"${follow_arg}"} || failed=1
        done < <(_wb_install_row_lines "${module}" "${id}" "${kind}")
    done < "${work}/answers"

    if [[ "${follow}" == "true" ]]; then
        for m in "${mods[@]}"; do
            while IFS= read -r line; do
                [[ -z "${line}" ]] && continue
                _wb_files_target_fields "${line}"
                [[ "${WB_T_KIND}" == "overrides" || "${WB_T_MODE}" == "layer" ]] && continue
                workbench_files_policy_set "${m}" "${WB_T_DEST}" follow
            done < <(workbench_files_targets "${m}")
            workbench_files_write_pending "${m}"
        done
    fi

    _wb_install_summary "${work}/plan" "${work}/answers" "${mods[@]}"
    rm -rf "${work}"
    return "${failed}"
}

# Modules fetched but never deployed — a quit at the install question, or
# a deploy that never ran.
_wb_install_staged_modules() {
    local m
    while IFS= read -r m; do
        [[ -z "${m}" ]] && continue
        if [[ -d "$(workbench_module_current_dir "${m}")" && -z "$(workbench_module_conf_get "${m}" RESOLVED_SHA "")" ]]; then
            printf '%s\n' "${m}"
        fi
    done < <(workbench_list_loadable_modules)
}

# ── --use-files at install time (wb add / wb install --bundle) ──────────────

# Every target of <module> where the user already has a config of their own
# — what 'wb files use' would move aside. Excludes overrides_src.
_wb_files_use_candidates() {
    local module="$1" line plan condition real
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        _wb_files_target_fields "${line}"
        [[ "${WB_T_KIND}" == "overrides" ]] && continue
        if [[ "${WB_T_MODE}" == "layer" ]]; then
            workbench_layers_target_is_users "${line}" && printf '%s\n' "${line}"
            continue
        fi
        real="$(_wb_expand_dest "${WB_T_DEST%/}")"
        if [[ -n "$(_wb_files_existing_yields "${WB_T_YIELD}")" ]]; then
            printf '%s\n' "${line}"
        elif [[ "${WB_T_MODE}" == "copy" ]]; then
            plan="$(workbench_files_plan "${module}" "${WB_T_DEST}" "${WB_T_SOURCE}" "${WB_T_SRC}" "${WB_T_LIFECYCLE}" "${WB_T_YIELD}")"
            condition="$(printf '%s\n' "${plan}" | cut -d'|' -f2)"
            [[ "${condition}" == "foreign" || "${condition}" == "yielded" ]] && printf '%s\n' "${line}"
        elif [[ -e "${real}" || -L "${real}" ]] && ! _wb_files_is_our_link "${module}" "${real}"; then
            printf '%s\n' "${line}"
        fi
    done < <(workbench_files_targets "${module}")
}

# _wb_files_clear_restored <module>
# Explicitly opting in again undoes an earlier 'wb remove --restore': the
# module's 'restored' rows and the skip policies restore left are cleared.
_wb_files_clear_restored() {
    local m="$1" dest line
    while IFS= read -r dest; do
        [[ -z "${dest}" ]] && continue
        workbench_files_ledger_delete "${m}" "${dest}"
        [[ "$(workbench_files_policy_get "${m}" "${dest}")" == "skip" ]] && workbench_files_policy_set "${m}" "${dest}" default
        # A layer's policy is keyed by its layer id (D82).
        line="$(_wb_files_line_for_dest "${m}" "${dest}")"
        if [[ "${dest}" == *'#'* && -n "${line}" && "$(workbench_files_policy_get "${m}" "${line%%|*}")" == "skip" ]]; then
            workbench_files_policy_set "${m}" "${line%%|*}" default
        fi
    done < <(workbench_files_ledger_rows "${m}" | awk -F'|' '$3 == "restored" { print $1 }')
}

# _wb_files_use_at_install <follow> <yes> <module>...
# One combined preview and one confirmation for every named module, then
# workbench_files_use per target. Explicit opt-in, so it first clears each
# module's 'restored' rows and their skip policies (an earlier
# 'wb remove --restore'). --follow sets per-entry follow on every target of
# those modules, not only the displaced ones.
_wb_files_use_at_install() {
    local follow="$1" yes="$2" m line rc failed=0 follow_arg=""
    shift 2
    local -a mods=() lines=()
    _wb_engine_require_files
    [[ "${follow}" == "true" ]] && follow_arg="follow"

    for m in "$@"; do
        [[ -d "$(workbench_module_current_dir "${m}")" ]] || continue
        _wb_files_clear_restored "${m}"
        while IFS= read -r line; do
            [[ -z "${line}" ]] && continue
            mods+=("${m}"); lines+=("${line}")
        done < <(_wb_files_use_candidates "${m}")
    done

    if [[ "${#lines[@]}" -gt 0 ]]; then
        echo
        echo "--use-files: you already have your own config for these — about to use the module's version instead:"
        local i=0
        while [[ "${i}" -lt "${#lines[@]}" ]]; do
            printf '  [%s]\n' "${mods[${i}]}"
            _wb_files_preview_use "${mods[${i}]}" "${lines[${i}]}"
            i=$((i + 1))
        done
        [[ "${follow}" == "true" ]] && echo "  ...and every file of $* keeps following its module after you edit it (edits are backed up each time)."
        echo
        echo "Backups go under $(_wb_files_backup_root)/ — 'wb files restore' puts yours back."
        echo
        _wb_files_confirm "${yes}" "--use-files"; rc=$?
        [[ "${rc}" -eq 1 ]] && return 1
        [[ "${rc}" -eq 2 ]] && return 0
        i=0
        while [[ "${i}" -lt "${#lines[@]}" ]]; do
            workbench_files_use "${mods[${i}]}" "${lines[${i}]}" ${follow_arg:+"${follow_arg}"} || failed=1
            i=$((i + 1))
        done
    elif [[ "${follow}" != "true" ]]; then
        log_info "--use-files: no existing configs of yours in the way — nothing to switch."
    fi

    if [[ "${follow}" == "true" ]]; then
        for m in "$@"; do
            [[ -d "$(workbench_module_current_dir "${m}")" ]] || continue
            while IFS= read -r line; do
                [[ -z "${line}" ]] && continue
                _wb_files_target_fields "${line}"
                [[ "${WB_T_KIND}" == "overrides" ]] && continue
                workbench_files_policy_set "${m}" "${WB_T_DEST}" follow
            done < <(workbench_files_targets "${m}")
            workbench_files_write_pending "${m}"
        done
        log_info "--use-files --follow: every file of $* now follows its module"
    fi
    return "${failed}"
}

# Total lines across every module's files.pending — for 'wb status'.
_wb_files_pending_total() {
    local file total=0
    for file in "$(workbench_modules_dir)"/*/files.pending; do
        [[ -s "${file}" ]] || continue
        total=$((total + $(wc -l < "${file}")))
    done
    printf '%s\n' "${total}"
}

# ── wb files settle ─────────────────────────────────────────────────────────

# _wb_cmd_files_settle [<module>]
# Puts workbench blocks back in position after something wrote to their
# files (docs/decisions-log.md D82, Core API _wb_layers_settle). Moves
# blocks only: no fetch, no other writes.
_wb_cmd_files_settle() {
    local module="${1:-}" m failed=0
    local -a modules=()
    if [[ $# -gt 1 ]]; then
        log_error "wb files settle: usage: wb files settle [<module>]"
        return 2
    fi
    _wb_engine_require_files
    if [[ -n "${module}" ]]; then
        _wb_files_require_module "wb files settle" "${module}" synced || return $?
        modules=("${module}")
    else
        while IFS= read -r m; do
            [[ -n "${m}" && -d "$(workbench_module_current_dir "${m}")" ]] && modules+=("${m}")
        done < <(workbench_list_registered_modules)
    fi
    for m in ${modules[@]+"${modules[@]}"}; do
        workbench_layers_settle "${m}" || failed=1
    done
    return "${failed}"
}

_wb_cmd_files() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "${sub}" in
        status)  _wb_cmd_files_status "$@" ;;
        diff)    _wb_cmd_files_diff "$@" ;;
        use)     _wb_cmd_files_use "$@" ;;
        resolve) _wb_cmd_files_resolve "$@" ;;
        policy)  _wb_cmd_files_policy "$@" ;;
        restore) _wb_cmd_files_restore "$@" ;;
        settle)  _wb_cmd_files_settle "$@" ;;
        *)
            log_error "wb files: usage: wb files status|diff|use|resolve|policy|restore|settle ... — see 'wb help files'"
            return 2
            ;;
    esac
}

# ── help / per-command detail ───────────────────────────────────────────────
# Each function below is one command's detail page: syntax line, one
# paragraph of description, flags/args, and — for the commands people
# confuse with each other — an explicit cross-reference explaining the
# difference. Inline heredocs, same pattern as _wb_usage itself, so this
# works identically from a fetched snapshot with no docs/ tree present.

_wb_help_status() {
    cat <<'EOF'
Usage: wb status

Prints one line per registered module: its TRACK_MODE, tracked ref,
resolved commit SHA, whether that module's own sync is enabled, and
whether it's registered at all. Also reports whether the fast (5-minute)
cadence is currently active (true whenever any module, core included, is
on branch: tracking).

Read-only — never fetches or changes anything. To act on drift shown here,
use 'wb update' (sync now) or 'wb track'/'wb dev' (change what a module
tracks).

When any deployed file is waiting on your decision, a last line says how
many — 'wb files status' lists them.
EOF
}

_wb_help_update() {
    cat <<'EOF'
Usage: wb update [<name>]

Fetches and deploys the latest content for one module (if <name> is
given) or every registered, sync-enabled module (if omitted) — right now,
regardless of the cadence timer. This is code-level only: it fetches,
atomically swaps in the new snapshot, and runs the module's post-deploy
hook.

Your files are never overwritten: a file you edited stays yours, and a
linked file with local changes is held at its current version. Run from a
terminal, 'wb update' then asks about anything waiting on you (the same
prompt as 'wb files resolve'); the scheduled timer never asks.

Updating 'core' specifically also detects whether core's resolved commit
actually changed and, if so, automatically re-runs the same host-level
convergence 'wb apply' performs (PATH symlink, shell rc stub, prereqs,
Ansible) — so a core update always leaves the host fully converged
without a separate manual step. A convergence failure here is logged as a
warning and never fails the update itself.

Confused with 'wb apply'? 'wb update' fetches new CODE for a module; 'wb
apply' re-runs HOST-level setup. 'wb update core' now triggers 'wb apply'
for you automatically when needed — nothing else does.

Confused with 'wb tools'? 'wb update' keeps registered MODULES current
(config text, shell registrations, core's own convergence). 'wb tools'
operates one level down — 'wb tools install'/'wb tools upgrade' handle
the TOOLS a module's install-* function happens to install. Neither one
implies the other.
EOF
}

_wb_help_install() {
    cat <<'EOF'
Usage: wb install [--bundle <name> [--keep-files | --use-files [--follow] [--yes]]] [--skip-ansible]

First-run convergence for this host: checks/installs shell prerequisites,
bootstraps the core module itself, symlinks 'wb' onto PATH, writes the
shell rc loader stub, provisions SSH deploy keys for any private modules,
refreshes the OS-level scheduled-sync timer IF it's already enabled (OFF
by default — see 'wb scheduler enable'; never installed automatically),
and (unless --skip-ansible is given, or ansible-playbook isn't found)
runs the Ansible convergence pass for whatever else it still covers
(host_vars templating etc.).

  --bundle <name>   Also register every module in the named bundle (the
                      known-modules catalog) before converging. If any of
                      them would touch config you already have, you're
                      asked once, for the whole bundle, before anything is
                      written — see 'wb help add'.
  --keep-files      With --bundle: answer "keep mine" without asking.
  --use-files       With --bundle: answer "use workbench's" — yours (and
                      any other file the same tool would also read) goes
                      to backups, and 'wb files restore' puts it back.
                      Your git identity and ssh hosts are kept. One preview
                      and one confirmation for the whole bundle.
  --follow          With --use-files: every file of those modules keeps
                      following its module even after you edit it (your
                      edits are backed up each time).
  --yes             Skip the --use-files confirmation. Without a terminal
                      and without --yes, --use-files refuses before
                      registering anything. '--use-files --yes' is the
                      scripted "give me everything" install.

Through bootstrap, the same flags go after 'bash -s --' (see
docs/getting-started.md).
  --skip-ansible    Skip the Ansible convergence step even if
                      ansible-playbook is available. Does not affect the
                      scheduled-sync timer, which never depended on Ansible.

Confused with 'wb apply'? Same convergence — 'wb install' is the first-run
entry point (and accepts --bundle); 'wb apply' is a literal alias for
re-running it later.
EOF
}

_wb_help_apply() {
    cat <<'EOF'
Usage: wb apply [--skip-ansible]

Re-runs the exact same convergence as 'wb install' (it is a literal
alias), minus --bundle — use this to re-converge a host after a manual
change, after installing Ansible, or any time you want the PATH
symlink/rc stub/prereqs/scheduled-sync timer (if enabled)/Ansible state
re-checked.

  --skip-ansible    Skip the Ansible convergence step even if
                      ansible-playbook is available. Does not affect the
                      scheduled-sync timer, which never depended on Ansible.

'wb update core' already calls this automatically — with --skip-ansible
when the background timer detected the change, without it when a human
ran 'wb update core'/'wb track core'/'wb dev core' directly — so you
normally don't need to run 'wb apply' by hand for core. Run it yourself
for anything 'wb update' doesn't cover.
EOF
}

_wb_help_add() {
    cat <<'EOF'
Usage: wb add <name> [url] [--private] [--allow-hooks] [--keep-files | --use-files [--follow] [--yes]] [--skip-layer <id>]...

Registers a new module and syncs it once. <url> is optional if <name>
resolves against the known-modules catalog. New modules default to
TRACK_MODE=latest.

Before anything is written, if the module would touch config you already
have — your ~/.gitconfig, a tmux.conf — it lists those files and asks:

  [k] keep mine (default)  yours stay; layered files (git, ssh, tmux, vim)
                           get workbench's defaults underneath, whole
                           files are left alone
  [u] use workbench's      yours are backed up and replaced; your git
                           identity and ssh hosts are kept
  [c] choose per file      keep, use, or skip (leave it completely alone)
  [d] show differences     yours vs workbench's, then ask again
  [q] quit                 nothing changes; the module stays registered
                           and 'wb update' asks again

On a fresh machine there's nothing to ask. Without a terminal (cron,
cloud-init, CI) the answer is always keep. Enter repeats your last
whole-host answer (k or u).

  --private       The module's repo is private (provisions an SSH deploy
                    key on first sync if one doesn't already exist).
  --allow-hooks   Permit this module's manifest-declared post_deploy hook
                    to actually run (hooks are opt-in per module).
  --keep-files    Answer keep without asking.
  --use-files     Answer use: where you already have your own config for
                    something this module ships, use the module's version
                    instead — yours goes to backups ('wb files restore'
                    puts it back). Works on an already-registered module
                    too.
  --follow        With --use-files: every file of this module keeps
                    following it even after you edit it (edits are
                    backed up each time).
  --yes           Skip the --use-files confirmation.
  --skip-layer <id>
                  Don't add this module's block to your own config file for
                    layer <id> (gitconfig, ssh_config, tmux.conf, vimrc, or
                    <tool>:over). Repeatable. Same as 'wb files policy
                    <name> <id> skip', set before anything is written.

Keeping a config you already have leaves it alone — modules that layer
into it add one marked block your own settings override (see 'wb help
files').

To change what an already-added module tracks, use 'wb track', not 'wb
add' again.
EOF
}

_wb_help_remove() {
    cat <<'EOF'
Usage: wb remove <name> [--restore [--yes]]

Deregisters a module so the loader and sync engine stop touching it.
Idempotent and non-destructive — content already deployed to disk is left
exactly as it is; nothing is deleted.

  --restore   First put back everything the module replaced or moved
                aside (from backups) and remove the files it created —
                'wb files restore <name> all', with the same preview and
                confirmation. Declining leaves the module registered.
  --yes       Skip the --restore confirmation.
EOF
}

_wb_help_track() {
    cat <<'EOF'
Usage: wb track <name> --latest | --branch <b> | --tag <t> | --commit <sha>

Sets what a registered module tracks, then syncs it once immediately.
Exactly one of the four flags is required:

  --latest          Newest vX.Y.Z tag (the default, production mode).
  --branch <b>      A branch's moving tip, re-checked every cycle. Also
                       drops the whole-host sync cadence to 5 minutes for
                       as long as anything is on branch: tracking.
  --tag <t>         An exact tag, static until changed again.
  --commit <sha>    An exact commit, static until changed again.

Returning a module to production is 'wb track <name> --latest', not a
separate command.

Confused with 'wb dev'? 'wb dev' is a guided, interactive prompt that
ends up calling this same command for you — use 'wb track' directly when
you already know exactly what to set.

Confused with 'wb sync enable|disable'? That toggles WHETHER a module
auto-syncs at all; this sets WHAT it tracks when sync is enabled. They're
independent, with one exception: switching into --branch tracking here
also force-enables sync, since dev tracking with sync off defeats the
purpose.
EOF
}

_wb_help_dev() {
    cat <<'EOF'
Usage: wb dev [<name>]

Guided, interactive wrapper over 'wb track' — not a separate mechanism.
With no argument, walks through every currently-registered module (core
included), prompting keep-or-switch to branch/tag/commit/latest for each.
With <name>, jumps straight to that one module.

Confused with 'wb track'? Same end result — 'wb dev' is the prompted,
one-module-at-a-time version; 'wb track' is the direct, scriptable
version for when you already know the exact flags to pass.
EOF
}

_wb_help_sync() {
    cat <<'EOF'
Usage: wb sync enable|disable [<name>]  |  wb sync run-if-due

  enable|disable [<name>]   Turns a module's background auto-sync on or
                              off, independent of what it tracks. No name
                              means core's own toggle.
  run-if-due                 Invoked by the background timer; a no-op
                              unless the current cadence interval has
                              elapsed. Not normally run by hand.

Confused with 'wb track'? 'wb sync enable|disable' controls WHETHER a
module is auto-synced at all; 'wb track' controls WHAT it tracks. A
module can be registered with sync disabled entirely (frozen at its last
snapshot) regardless of what TRACK_MODE it's set to.
EOF
}

_wb_help_scheduler() {
    cat <<'EOF'
Usage: wb scheduler enable|disable|status

Controls whether the OS-level scheduled-sync timer (systemd --user timer
on Linux/WSL2, launchd agent on macOS) exists on this host at all — a
separate, host-wide layer underneath 'wb sync enable|disable [<name>]'.

  enable     Turns scheduled sync on for this host and installs/starts the
              timer immediately (no separate 'wb apply' needed). OFF by
              default (docs/decisions-log.md D38) — nothing is ever written
              to systemd/launchd, or run in the background, until you run
              this once.
  disable    Turns scheduled sync off and immediately removes the
              installed timer/agent — not just "stops reinstalling it on
              the next wb apply".
  status     Whether scheduled sync is enabled on this host, and (if so)
              whether the OS timer is actually active right now.

Confused with 'wb sync enable|disable [<name>]'? That one is per-MODULE:
which modules a *running* timer is allowed to touch. This one is the
timer's own on/off switch for the whole host. Both must be "on" — this
enabled, AND a given module's own sync enabled — for that module to ever
be touched automatically. 'wb apply' never installs, upgrades, or removes
the timer on its own initiative; it only ever refreshes an
already-enabled one, and does nothing at all while disabled.
EOF
}

_wb_help_functions() {
    cat <<'EOF'
Usage: wb functions [--all] [--no-pager] [--no-aliases] [--compact]

Lists every registered shell function/getter/installer, grouped by the
module that declared it (via that module's manifest register: block).
Read-only.

A function whose declared "_<name>-available" predicate reports it can't
actually be used on this host (a required CLI is missing, say) is left out
of the main list and shown in a separate "available once tooling is
installed" block underneath, grouped by what it needs — with the
`wb tools install <tool>` command when an installer for that tool is
registered. Those functions are still defined and callable; this only
changes what is listed as usable. See docs/module-authoring.md "Declaring
function availability". --all (or WORKBENCH_FUNCTIONS_SHOW_ALL=true, which
also works in front of any module's own get-<domain>-functions getter)
lists every function in the main list regardless of availability, with no
separate block.

On a real terminal, output is piped through a pager: WORKBENCH_PAGER if
set (empty/"cat"/"none" disables this outright), else PAGER, else a bare
'less -F -R -X' if installed, else no pager. Never pages when stdout is
redirected or captured (a file, a pipe, $(...)) — only affects what you
see interactively. --no-pager skips this for one call regardless of
WORKBENCH_PAGER/PAGER. --no-aliases omits the "Loaded aliases" section,
listing only loaded functions and getters — this is what the automatic
WORKBENCH_SHOW_FUNCTIONS startup banner uses (unpaged, no aliases) so it
stays a quick summary rather than a full listing every new shell.
--compact replaces each "available once tooling is installed" block with
one line (a count per missing tool); the startup banner uses it too, and
module getters never do.

Confused with 'wb tools'? This lists the raw register.installers[] src
paths a manifest declares; 'wb tools' lists (and can invoke) the actual
install-<name> functions discovered inside those files.
EOF
}

_wb_help_tools() {
    cat <<'EOF'
Usage: wb tools [list [--status]]  |  wb tools install <name>|all  |  wb tools upgrade [<name>|all]

The tool-updating framework: discovers and invokes install-<name>
functions any registered, sync-enabled module declared via its manifest's
register.installers[] entries. Core only knows a function exists and its
friendly name (install-<name> with the prefix stripped) — it does not
know or guess how any tool is installed, checked, or updated unless the
module tells it via an optional installed-<name> predicate (see below);
that's entirely the module author's responsibility
(docs/module-authoring.md).

  list [--status]     Print every discovered installer, grouped by owning
                        module. With --status, also runs each tool's
                        installed-<name> predicate (if declared) and shows
                        whether it's already installed. Default with no
                        subcommand.
  install <name>|all  Runs install-<name>, first-time or not — always
                        requires an explicit target. 'all' lists every
                        discovered tool and requires a y/N confirmation
                        before running any of them; nothing runs on a
                        bare 'wb tools install'.
  upgrade [<name>|all] Only touches a tool whose installed-<name>
                        predicate reports it as already installed.
                        Anything not installed, or with no predicate
                        declared at all (or one that errors), is skipped
                        and never run — 'not installed' is silent,
                        'unresponsive' is reported once at the end.
                        Safe to run bare: it only ever acts on what's
                        already there.

<name> is the friendly name shown in 'wb tools list' (e.g. "direnv"), not
the underlying install-<name> function — though the install-<name> form
is also accepted, as a fallback, since it's what 'wb tools list' prints
alongside each friendly name.

Two modules declaring the same friendly name is a collision, resolved by
first-by-module-name-order-wins and warned about once — 'wb tools list'
always reflects the winner. 'all'/'list'/'install'/'upgrade'/'status' are
reserved and can never be used as a friendly tool name.

Manual only — never invoked by the background timer/'wb sync run-if-due'.

Confused with 'wb update'? 'wb update' keeps registered MODULES current
(config text, shell registrations, core's own convergence). 'wb tools'
operates one level down — tools that happen to get installed by functions
a module ships. Neither implies the other.
EOF
}

_wb_help_module() {
    cat <<'EOF'
Usage: wb module info <name>  |  wb module docs <name>  |  wb module reset <name> <target>|all [--yes]

Module-published information — distinct from 'wb status' (sync/tracking
state core already knows regardless of what a module publishes) and from
'wb help <command>' (this CLI's own usage text, not anything about a
module).

  info <name>   Repository, tracking, and registration facts core already
                 tracks, plus an optional one-line description
                 (info.description in the module's manifest) if the
                 module publishes one.
  docs <name>   The module's HELP.md, falling back to README.md, read
                 straight from its synced snapshot — nothing else is
                 checked. Neither present prints a pointer to the
                 module's repository instead.
  reset <name> <target>|all [--follow] [--yes]
                 The same as 'wb files use' — "get me back to the
                 workbench default". Your current version is backed up
                 first; without a terminal it needs --yes. See
                 'wb help files'.

Both info and docs require <name> to already be registered ('wb add
<name>' first) and synced at least once ('wb update <name>' if 'wb add'
hasn't run yet) — reset requires the same.
EOF
}

_wb_help_files() {
    cat <<'EOF'
Usage: wb files status [<module>]
       wb files diff <module> <file>
       wb files use <module> <file>|all [--follow] [--yes]
       wb files resolve <module> <file>|all [keep|manage|use] [--follow] [--yes]
       wb files policy [<module> <file> skip|seed|managed|follow|default] [--default managed|follow] [--yes]
       wb files restore <module> <file>|all [--yes]
       wb files settle [<module>]

Every file a module deploys outside its own snapshot — a tmux.conf, a
vimrc, a whole nvim config — is core's to manage and yours to own
(docs/decisions-log.md D81). Workbench never removes or replaces a file
it didn't put there, never re-creates one you deleted, and never throws
away a change you made: an edited copy stops updating, and a linked file
with local changes is held at its current version until you choose.

  status    Read-only. What's waiting on you, then every file: its mode,
              policy (* = set for that file), state, and what the next
              update will do.
  diff      Read-only. Your copy against the module's version; for a
              held link, what changed locally and how it differs from
              the module now.
  use       Take the module's version. What's there now — and any other
              file the same tool would also read (the module's yield_to
              paths) — is moved to backups, so 'restore' can put it
              back. Afterwards it stays current until you edit it;
              --follow keeps it following even then (edits backed up).
              'all' leaves out the module's local-overrides file.
  resolve   Decide about something waiting (or a linked file, ahead of
              any change):
                keep    — mine from now on, no more updates
                manage  — keep my changes, keep updating everything else
                use     — take the module's version (mine is backed up)
              With no choice, asks interactively (terminal only).
  policy    No arguments: the host default and every per-file policy.
              <module> <file> <policy>: skip (never touch it), seed
              (create once, never update; copies only), managed (update
              while unedited), follow (always update, backing up your
              edits), default (back to the module/host default) —
              applied now, not at the next release.
              --default managed|follow: the host-wide default for every
              managed copy and linked file. It never moves a directory
              of yours.
  restore   Put things back as they were before the module: originals
              and moved-aside files return from backups, and what
              workbench created is removed. Anything you put in place of
              workbench's file is left alone. 'all' leaves out the
              module's local-overrides file.
  settle    Put workbench blocks back in place after something wrote to
              your file (a module function running 'git config --global',
              say). Moves blocks only.

Layers (docs/decisions-log.md D82). For a tool you already configure —
git, ssh, tmux, vim — a module adds one marked block to your own file
(~/.gitconfig, ~/.ssh/config, your tmux.conf or vimrc) that includes the
module's settings, placed so anything you set outside the block wins.
Module updates flow through without asking. Name a layer by its id: the
tool (gitconfig, ssh_config, tmux.conf, vimrc), or <tool>:over for the
few blocks placed to win (workbench-git's per-project identities).
  status, diff    list layers and show the block against what's in the file
  use             back up your file and leave only workbench's block
  restore         remove the block (and put back what 'use' backed up)
  policy          skip (remove the block, stop adding it), managed or
                    default (add it again) — seed and follow don't apply
  resolve         your file is a symlink (stow, chezmoi...): use writes
                    the block through the link, keep skips the layer
Delete the block's marker lines yourself and workbench never adds it back.

<file> is the file's dest (~/.config/tmux/tmux.conf), its basename
(tmux.conf), its path in the module's repo (files/tmux.conf), or a layer
id (gitconfig, gitconfig:over).

Anything that writes shows a preview, names the backup folder, and asks
first. Without a terminal it refuses unless given --yes.
EOF
}

_wb_help_version() {
    cat <<'EOF'
Usage: wb version

Prints the workbench-core release version (from the repo-root VERSION
file) and the script-local version registered by every file loaded into
this process.
EOF
}

_wb_help_completion() {
    cat <<'EOF'
Usage: wb completion bash|zsh

Prints a tab-completion script for the given shell to stdout. You don't
need to run this by hand — it's wired up automatically once 'wb' itself
is registered (shell/completions/wb.sh sources a cached copy, regenerated
whenever workbench-core's release version changes).

Completes top-level command names (e.g. 'wb st<TAB>' -> 'wb status'),
each command group's own sub-commands ('wb tools <TAB>', 'wb module
<TAB>', 'wb sync <TAB>', 'wb scheduler <TAB>'), and the actual current
registered module names, catalog module/bundle names, and discovered
tool names on this host (e.g. 'wb track <TAB>' only offers modules
you've actually registered — never a deregistered one). Flag names
(--private, --bundle, etc.) and 'wb module reset <name>'s own target
argument aren't completed yet — see docs/decisions-log.md D54.
EOF
}

_wb_help_reload() {
    cat <<'EOF'
Usage: wb reload

Re-sources workbench-core in *this* shell without running a real sync —
useful right after the background scheduled-sync timer changed something
you didn't run by hand. Only exists as a shell function, defined by
lib/loader.sh (docs/decisions-log.md D39): every shell that's sourced it
already gets this and every state-changing 'wb' command (update, apply,
add, remove, track, dev, sync) auto-reloading after itself, with no
separate step needed. If you're seeing an error instead of this text,
that wrapper isn't in scope yet — run 'source ~/.bashrc' or open a new
shell once.
EOF
}

_wb_help_help() {
    cat <<'EOF'
Usage: wb help [<command>]  |  wb <command> --help  |  wb <command> -h

With no argument, prints the same top-level command summary as plain
'wb'. With a command name, prints that command's detailed usage —
identical to running 'wb <command> --help'.
EOF
}

# _wb_cmd_help [<command>]
# With no argument, behaves exactly like the bare top-level usage block.
# With an unrecognised command name, doesn't error — prints the top-level
# block plus a one-line note, matching the unknown-command fallback below.
_wb_cmd_help() {
    local cmd="${1:-}"
    [[ -z "${cmd}" ]] && { _wb_usage; return 0; }

    case "${cmd}" in
        status)     _wb_help_status ;;
        update)     _wb_help_update ;;
        functions)  _wb_help_functions ;;
        tools)      _wb_help_tools ;;
        module)     _wb_help_module ;;
        files)      _wb_help_files ;;
        install)    _wb_help_install ;;
        apply)      _wb_help_apply ;;
        add)        _wb_help_add ;;
        remove)     _wb_help_remove ;;
        track)      _wb_help_track ;;
        dev)        _wb_help_dev ;;
        sync)       _wb_help_sync ;;
        scheduler)  _wb_help_scheduler ;;
        version)    _wb_help_version ;;
        completion) _wb_help_completion ;;
        help)       _wb_help_help ;;
        reload)     _wb_help_reload ;;
        *)
            echo "wb help: unknown command '${cmd}'"
            echo
            _wb_usage
            ;;
    esac
}

# ── dispatch ───────────────────────────────────────────────────────────────
_wb_cmd="${1:-}"
[[ $# -gt 0 ]] && shift

# Central "is this a help request" interception, for every command, rather
# than a -h/--help check duplicated inside each subcommand handler: if the
# first remaining argument after the command name is -h/--help, show that
# command's detail instead of dispatching to its real handler.
if [[ -n "${_wb_cmd}" && "${_wb_cmd}" != "help" && "${_wb_cmd}" != "-h" && "${_wb_cmd}" != "--help" ]]; then
    case "${1:-}" in
        -h|--help) _wb_cmd_help "${_wb_cmd}"; exit 0 ;;
    esac
fi

case "${_wb_cmd}" in
    install)    _wb_cmd_install "$@" ;;
    apply)      _wb_cmd_apply "$@" ;;
    add)        _wb_require modules/add.sh; workbench_cmd_add "$@" ;;
    remove)     _wb_require modules/remove.sh; workbench_cmd_remove "$@" ;;
    track)      _wb_require modules/track.sh; workbench_cmd_track "$@" ;;
    dev)        _wb_require modules/dev.sh; workbench_cmd_dev "$@" ;;
    sync)       _wb_cmd_sync "$@" ;;
    scheduler)  _wb_cmd_scheduler "$@" ;;
    update)     _wb_cmd_update "$@" ;;
    status)     _wb_cmd_status "$@" ;;
    functions)  _wb_cmd_functions "$@" ;;
    tools)      _wb_cmd_tools "$@" ;;
    module)     _wb_cmd_module "$@" ;;
    files)      _wb_cmd_files "$@" ;;
    version)    _wb_cmd_version "$@" ;;
    completion) _wb_cmd_completion "$@" ;;
    __complete) _wb_cmd_complete "$@" ;;
    __sync-continue) _wb_cmd_sync_continue "$@" ;;
    help)       _wb_cmd_help "$@" ;;
    reload)
        log_error "wb reload: this only works as a shell function, defined by lib/loader.sh — a subprocess (this one) can't reload its own parent shell. Either you're not in a shell that's sourced lib/loader.sh yet, or this host predates this wrapper (docs/decisions-log.md D39). Run 'source ~/.bashrc' (or open a new shell) once — 'wb reload' and every state-changing 'wb' command will auto-reload from then on."
        exit 1
        ;;
    -h|--help|"") _wb_usage ;;
    *)
        echo "wb: unknown command '${_wb_cmd}'" >&2
        _wb_usage >&2
        exit 2
        ;;
esac
